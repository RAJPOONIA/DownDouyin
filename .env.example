PORT=3000
HOST=0.0.0.0

# Legacy read-only stats token for GET /api/stats/downloads (optional)
ADMIN_STATS_TOKEN=

# ==================== ADMIN CONTROL CENTER (/admin) ====================
# Initial owner account bootstrap (if logs/admin-users.json does not exist yet).
# Option A: Set ADMIN_INITIAL_PASSWORD (min 10 chars) to auto-provision the owner account on startup.
# Option B: Leave blank and use the one-time token generated in logs/admin-setup-token.txt at /admin.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@downdouyin.com
ADMIN_INITIAL_PASSWORD=
ADMIN_PASSWORD_HASH=
# Optional one-time setup token override (used only when no admin user exists yet)
ADMIN_SETUP_TOKEN=
# Emergency recovery only: set temporarily and restart server to reset owner password, then remove from .env
ADMIN_RESET_PASSWORD=

# Optional search-box shortcut phrase (routes to /admin login screen only; never authenticates)
ADMIN_SHORTCUT_PHRASE=

# ==================== TRANSACTIONAL EMAIL (RESEND HTTPS API) ====================
# Get an API key from https://resend.com to enable real email notifications for contact inquiries and error alerts
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=DownDouyin Admin <onboarding@resend.dev>
ADMIN_ALERT_EMAIL=

# ==================== GOOGLE ANALYTICS 4 & SEARCH CONSOLE ====================
# Frontend GA4 Measurement ID (installed in static/index.html)
GA4_MEASUREMENT_ID=G-S9BHCYX6EN
# Optional numeric GA4 Property ID for live server-side GA4 Data API queries in /admin
GA4_PROPERTY_ID=
# Optional Google Search Console property URL (e.g. https://downdouyin.com/ or sc-domain:downdouyin.com)
GSC_SITE_URL=https://downdouyin.com/
# Optional Google Cloud Service Account JSON (raw JSON string or base64-encoded JSON) with Viewer access to GA4 / GSC
GOOGLE_SERVICE_ACCOUNT_JSON=

# ==================== PLATFORM UPSTREAM OPTIONAL CONFIG ====================
BILIBILI_COOKIE=
