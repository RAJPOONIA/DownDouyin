    <div class="modal-body">
      <div class="modal-tabs">
        <button type="button" class="modal-tab active" data-pane="bili" id="tabPaneBili">Bilibili Account (SESSDATA)</button>
        <button type="button" class="modal-tab" data-pane="tiktok" id="tabPaneTiktok">TikTok Proxy</button>
      </div>

      <div id="paneBili">
        <p style="margin-bottom:8px">Configure your Bilibili <code>SESSDATA</code> cookie to unlock 1080P &amp; 4K UHD streams. Douyin Original Quality &amp; 1080P HD extraction is already built-in automatically.</p>
        <div id="biliCfgStatus" style="padding:10px 12px;border-radius:10px;background:var(--card-sub);border:1px solid var(--border-soft);margin-bottom:10px;font-size:12.5px">Checking Bilibili configuration...</div>
        <label style="font-weight:700;font-size:13px;color:var(--text-main)" for="biliCookieInput">Paste Bilibili Cookie / SESSDATA</label>
        <textarea id="biliCookieInput" class="cfg-field" rows="4" placeholder="Paste SESSDATA=... or cookies.txt content here"></textarea>
        <div style="display:flex;gap:10px;justify-content:flex-end">
          <button type="button" class="btn-row-dl" style="background:#64748B" id="btnClearBiliCookie">Clear Cookie</button>
          <button type="button" class="btn-row-dl" id="btnSaveBiliCookie">Save Cookie</button>
        </div>
      </div>

      <div id="paneTiktok" style="display:none">
        <p style="margin-bottom:8px">If your server is in a region that requires a local HTTP proxy to reach TikTok, enter your proxy URL below (leave blank for direct connection).</p>
        <div id="ttCfgStatus" style="padding:10px 12px;border-radius:10px;background:var(--card-sub);border:1px solid var(--border-soft);margin-bottom:10px;font-size:12.5px">Checking TikTok configuration...</div>
        <label style="font-weight:700;font-size:13px;color:var(--text-main)" for="ttProxyInput">HTTP Proxy URL</label>
        <input type="text" id="ttProxyInput" class="cfg-field" placeholder="http://127.0.0.1:7890">
        <div style="display:flex;gap:10px;justify-content:flex-end">
          <button type="button" class="btn-row-dl" style="background:#64748B" id="btnClearTtProxy">Clear Proxy</button>
