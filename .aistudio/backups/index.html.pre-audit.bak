<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>DownDouyin — Download Videos from Douyin, Bilibili, TikTok and Xiaohongshu</title>
<meta name="description" content="DownDouyin is a fast, simple, high-quality watermark-free video downloader supporting Douyin, Bilibili, TikTok, and Xiaohongshu (RedNote).">
<meta property="og:title" content="DownDouyin — Video Downloader for Douyin, Bilibili, TikTok &amp; Xiaohongshu">
<meta property="og:description" content="Fast, simple, high-quality video, audio, and thumbnail downloads from Douyin, Bilibili, TikTok, and Xiaohongshu.">
<meta property="og:type" content="website">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><defs><linearGradient id='g' x1='0%' y1='0%' x2='100%' y2='100%'><stop offset='0%' stop-color='%235B35FF'/><stop offset='100%' stop-color='%239B51E0'/></linearGradient></defs><rect width='64' height='64' rx='16' fill='url(%23g)'/><polygon points='25,18 25,46 47,32' fill='%23ffffff'/></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-S9BHCYX6EN"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  if (!window.__ddGaInitialized) {
    window.__ddGaInitialized = true;
    gtag('js', new Date());
    gtag('config', 'G-S9BHCYX6EN', {
      send_page_view: true,
      page_location: window.location.origin + window.location.pathname
    });
  }
</script>
<style>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --bg-page: #F3F5FA;
    --bg-header: rgba(255, 255, 255, 0.94);
    --card-bg: #FFFFFF;
    --card-sub: #F8FAFC;
    --border-color: #E2E8F0;
    --border-soft: #EDF1F7;
    --text-main: #0F172A;
    --text-sub: #475569;
    --text-muted: #94A3B8;
    --purple-600: #633BFF;
    --purple-500: #7C4DFF;
    --blue-500: #3B82F6;
    --accent-grad: linear-gradient(135deg, #5B35FF 0%, #8B5CF6 100%);
    --btn-grad: linear-gradient(90deg, #5835FF 0%, #9353FF 100%);
    --shadow-card: 0 10px 30px -5px rgba(15, 23, 42, 0.05), 0 4px 12px -2px rgba(15, 23, 42, 0.03);
    --shadow-hover: 0 14px 34px -6px rgba(99, 59, 255, 0.12);
    --hero-bg: radial-gradient(ellipse at 50% 25%, #1A274B 0%, #0D152C 62%, #080E1F 100%);
  }

  html[data-theme="dark"] {
    --bg-page: #0B1120;
    --bg-header: rgba(15, 23, 42, 0.92);
    --card-bg: #131C31;
    --card-sub: #1A2540;
    --border-color: #263452;
    --border-soft: #1E2B45;
    --text-main: #F8FAFC;
    --text-sub: #94A3B8;
    --text-muted: #64748B;
    --shadow-card: 0 12px 32px rgba(0, 0, 0, 0.35);
  }

  html {
    scroll-behavior: smooth;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: var(--text-main);
    background-color: var(--bg-page);
    -webkit-font-smoothing: antialiased;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: var(--bg-page);
    color: var(--text-main);
    overflow-x: hidden;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  /* ==================== TOP NAVIGATION HEADER ==================== */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg-header);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border-color);
  }

  .header-inner {
    max-width: 1280px;
    margin: 0 auto;
    height: 68px;
    padding: 0 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
    color: var(--text-main);
    font-weight: 800;
    font-size: 21px;
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }

  .brand-logo {
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: var(--accent-grad);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 16px rgba(99, 59, 255, 0.32);
    flex-shrink: 0;
  }

  .brand-logo svg {
    width: 18px;
    height: 18px;
    fill: #FFFFFF;
    margin-left: 2px;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-item {
    position: relative;
    text-decoration: none;
    color: var(--text-sub);
    font-size: 14px;
    font-weight: 600;
    padding: 22px 2px;
    transition: color 0.16s ease;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: none;
    border: none;
    font-family: inherit;
  }

  .nav-item:hover,
  .nav-item.active {
    color: var(--purple-600);
  }

  .nav-item.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 3px;
    border-radius: 3px 3px 0 0;
    background: var(--purple-600);
  }

  /* Tools Dropdown */
  .nav-dropdown-wrap {
    position: relative;
  }

  .nav-dropdown {
    position: absolute;
    top: calc(100% - 6px);
    left: 0;
    min-width: 225px;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    box-shadow: 0 16px 36px rgba(15, 23, 42, 0.14);
    padding: 8px;
    display: none;
    flex-direction: column;
    gap: 2px;
    z-index: 120;
  }

  .nav-dropdown-wrap.open .nav-dropdown {
    display: flex;
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border-radius: 9px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-main);
    text-decoration: none;
    background: none;
    border: none;
    width: 100%;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.14s ease, color 0.14s ease;
  }

  .dropdown-item:hover {
    background: var(--card-sub);
    color: var(--purple-600);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  /* Theme Switch Pill */
  .theme-pill {
    width: 56px;
    height: 30px;
    border-radius: 999px;
    background: #E2E8F0;
    border: 1px solid var(--border-color);
    padding: 3px;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    position: relative;
    transition: background 0.2s ease;
  }

  html[data-theme="dark"] .theme-pill {
    background: #1E293B;
  }

  .theme-pill .sun-icon {
    width: 22px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #F59E0B;
    z-index: 1;
  }

  .theme-pill .knob {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #FFFFFF;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.18);
    transition: transform 0.2s ease;
  }

  html[data-theme="dark"] .theme-pill .knob {
    transform: translateX(-26px);
    background: #38BDF8;
  }

  /* Language Selector */
  .lang-wrap {
    position: relative;
  }

  .lang-btn {
    height: 36px;
    padding: 0 12px;
    border-radius: 10px;
    border: 1px solid var(--border-color);
    background: var(--card-bg);
    color: var(--text-main);
    font-size: 13px;
    font-weight: 600;
    font-family: inherit;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }

  .lang-btn:hover {
    border-color: var(--purple-600);
  }

  .lang-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    min-width: 130px;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.12);
    padding: 6px;
    display: none;
    flex-direction: column;
    z-index: 120;
  }

  .lang-wrap.open .lang-menu {
    display: flex;
  }

  .lang-opt {
    padding: 8px 10px;
    border-radius: 8px;
    border: none;
    background: none;
    text-align: left;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-main);
    cursor: pointer;
    font-family: inherit;
  }

  .lang-opt:hover,
  .lang-opt.active {
    background: var(--card-sub);
    color: var(--purple-600);
  }

  /* Upgrade / HD Settings Button */
  .btn-upgrade {
    height: 38px;
    padding: 0 16px;
    border-radius: 10px;
    border: none;
    background: var(--btn-grad);
    color: #FFFFFF;
    font-size: 13.5px;
    font-weight: 700;
    font-family: inherit;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    cursor: pointer;
    box-shadow: 0 6px 16px rgba(99, 59, 255, 0.28);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .btn-upgrade:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(99, 59, 255, 0.38);
  }

  /* ==================== HERO SECTION ==================== */
  .hero-section {
    position: relative;
    background: var(--hero-bg);
    color: #FFFFFF;
    padding: 46px 28px 66px;
    overflow: hidden;
  }

  .hero-bg-waves {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.72;
  }

  .hero-container {
    position: relative;
    z-index: 2;
    max-width: 1240px;
    margin: 0 auto;
    text-align: center;
  }

  /* Left Decorative Callout */
  .hero-callout-left {
    position: absolute;
    left: 10px;
    top: 86px;
    text-align: left;
    pointer-events: none;
    user-select: none;
  }

  .hero-callout-left .callout-lines {
    font-family: 'Caveat', cursive;
    font-size: 23px;
    line-height: 1.18;
    color: #E2E8F0;
    transform: rotate(-4deg);
  }

  .hero-callout-left .callout-lines .hl {
    color: #A78BFA;
    font-weight: 700;
  }

  /* Right Decorative Callout & Floating Platform Tiles */
  .hero-deco-right {
    position: absolute;
    right: 6px;
    top: 34px;
    width: 250px;
    height: 240px;
    pointer-events: none;
    user-select: none;
  }

  .hero-callout-right {
    position: absolute;
    left: -18px;
    top: 52px;
    font-family: 'Caveat', cursive;
    font-size: 21px;
    line-height: 1.15;
    color: #CBD5E1;
    text-align: left;
    transform: rotate(-3deg);
  }

  .floating-tiles {
    position: absolute;
    right: 0;
    top: 8px;
    width: 170px;
    height: 210px;
  }

  .float-tile {
    position: absolute;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.45), inset 0 1px 1px rgba(255, 255, 255, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.18);
  }

  .float-tile.tile-bili {
    width: 54px;
    height: 54px;
    left: 26px;
    top: 12px;
    background: linear-gradient(135deg, #00A1D6, #0077AA);
    transform: rotate(-14deg);
    font-weight: 800;
    font-size: 13px;
    color: #fff;
  }

  .float-tile.tile-tt-top {
    width: 60px;
    height: 60px;
    right: 12px;
    top: 18px;
    background: linear-gradient(145deg, #1E1E28, #0B0B12);
    transform: rotate(12deg);
  }

  .float-tile.tile-dy-bot {
    width: 56px;
    height: 56px;
    left: 18px;
    top: 96px;
    background: linear-gradient(145deg, #191A24, #0A0B10);
    transform: rotate(-11deg);
  }

  .float-tile.tile-xhs {
    width: 62px;
    height: 62px;
    right: 14px;
    top: 102px;
    background: linear-gradient(135deg, #FF2442, #D8112B);
    transform: rotate(10deg);
    font-weight: 800;
    font-size: 14px;
    color: #FFFFFF;
    letter-spacing: -0.5px;
  }

  /* Hero Headings */
  .hero-title {
    font-size: clamp(28px, 3.3vw, 43px);
    font-weight: 800;
    line-height: 1.22;
    letter-spacing: -0.025em;
    max-width: 780px;
    margin: 0 auto 12px;
  }

  .hero-title .grad-text {
    background: linear-gradient(90deg, #93C5FD 0%, #C4B5FD 50%, #A78BFA 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: block;
  }

  .hero-subtitle {
    font-size: 16px;
    font-weight: 600;
    color: #CBD5E1;
    margin-bottom: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .hero-subtitle .dot-sep {
    color: #8B5CF6;
  }

  /* Search Input Bar */
  .search-bar-outer {
    max-width: 770px;
    margin: 0 auto 26px;
    padding: 5px;
    border-radius: 18px;
    background: linear-gradient(90deg, rgba(99, 59, 255, 0.55), rgba(59, 130, 246, 0.45), rgba(139, 92, 246, 0.55));
    box-shadow: 0 18px 46px rgba(8, 14, 31, 0.55), 0 0 28px rgba(124, 77, 255, 0.28);
  }

  .search-bar {
    background: #FFFFFF;
    border-radius: 14px;
    display: flex;
    align-items: center;
    padding: 6px 6px 6px 18px;
    gap: 10px;
  }

  .search-link-icon {
    color: #94A3B8;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 15px;
    font-weight: 500;
    color: #0F172A;
    font-family: inherit;
    min-width: 0;
    height: 44px;
  }

  .search-input::placeholder {
    color: #94A3B8;
  }

  .search-clear-btn {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: none;
    background: #F1F5F9;
    color: #64748B;
    display: none;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    font-size: 13px;
  }

  .search-clear-btn.visible {
    display: inline-flex;
  }

  .search-clear-btn:hover {
    background: #E2E8F0;
    color: #0F172A;
  }

  .btn-fetch {
    height: 48px;
    padding: 0 24px;
    border-radius: 11px;
    border: none;
    background: var(--btn-grad);
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 700;
    font-family: inherit;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    cursor: pointer;
    flex-shrink: 0;
    box-shadow: 0 8px 20px rgba(99, 59, 255, 0.35);
    transition: transform 0.15s ease, filter 0.15s ease;
  }

  .btn-fetch:hover:not(:disabled) {
    transform: translateY(-1px);
    filter: brightness(1.06);
  }

  .btn-fetch:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  /* 4 Supported Platforms Row */
  .hero-platforms {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 36px;
    flex-wrap: wrap;
    padding-top: 4px;
  }

  .plat-btn {
    background: none;
    border: none;
    color: #E2E8F0;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 600;
    transition: transform 0.16s ease, color 0.16s ease;
    position: relative;
    padding: 4px 8px;
  }

  .plat-btn:hover {
    transform: translateY(-2px);
    color: #FFFFFF;
  }

  .plat-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 13px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.32);
    border: 2px solid rgba(255, 255, 255, 0.14);
    transition: border-color 0.16s ease, box-shadow 0.16s ease, transform 0.16s ease;
  }

  .plat-btn.active .plat-icon-box {
    border-color: #A78BFA;
    box-shadow: 0 0 0 3px rgba(167, 139, 250, 0.28), 0 10px 22px rgba(0, 0, 0, 0.4);
  }

  .plat-icon-box.douyin,
  .plat-icon-box.tiktok {
    background: #0F1016;
  }

  .plat-icon-box.bilibili {
    background: #00A1D6;
  }

  .plat-icon-box.xhs {
    background: #FF2442;
  }

  /* Curved Wave Divider at bottom of Hero */
  .hero-wave-bottom {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    line-height: 0;
    pointer-events: none;
  }

  .hero-wave-bottom svg {
    width: 100%;
    height: 36px;
    display: block;
  }

  .hero-wave-bottom .wave-fill {
    fill: var(--bg-page);
    transition: fill 0.2s ease;
  }

  /* ==================== MAIN WORKSPACE ==================== */
  .main-workspace {
    max-width: 1280px;
    width: 100%;
    margin: -18px auto 0;
    padding: 0 28px 48px;
    position: relative;
    z-index: 5;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  /* Error Banner */
  .error-banner {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: #FEF2F2;
    border: 1px solid #FECACA;
    color: #B91C1C;
    padding: 12px 18px;
    border-radius: 14px;
    margin-bottom: 18px;
    font-size: 13.5px;
    font-weight: 600;
  }

  html[data-theme="dark"] .error-banner {
    background: rgba(185, 28, 28, 0.16);
    border-color: rgba(248, 113, 113, 0.35);
    color: #FCA5A5;
  }

  .error-banner.show {
    display: flex;
  }

  /* 2-Column Main Grid */
  .dashboard-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: 24px;
    align-items: stretch;
  }

  .panel-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 20px;
    padding: 24px;
    box-shadow: var(--shadow-card);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .preview-panel-card {
    display: flex;
    flex-direction: column;
  }

  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
  }

  .section-title-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .section-bar {
    width: 4px;
    height: 20px;
    border-radius: 4px;
    background: var(--accent-grad);
    flex-shrink: 0;
  }

  .section-title {
    font-size: 18px;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.01em;
  }

  /* ==================== VIDEO PREVIEW STATES ==================== */
  /* Clean Professional Empty State */
  .preview-empty-state {
    flex: 1;
    min-height: 310px;
    border-radius: 16px;
    border: 1.5px dashed var(--border-color);
    background: var(--card-sub);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 36px 24px;
    gap: 14px;
  }

  .empty-state-icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: rgba(99, 59, 255, 0.08);
    color: var(--purple-600);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  html[data-theme="dark"] .empty-state-icon {
    background: rgba(139, 92, 246, 0.16);
    color: #A78BFA;
  }

  .empty-state-msg {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--text-sub);
    max-width: 360px;
    line-height: 1.5;
  }

  /* Loading State inside Video Preview Card */
  .preview-loading-state {
    flex: 1;
    min-height: 310px;
    border-radius: 16px;
    border: 1px solid var(--border-soft);
    background: var(--card-sub);
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 36px 24px;
    gap: 14px;
  }

  .loading-spinner {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 3px solid rgba(99, 59, 255, 0.18);
    border-top-color: var(--purple-600);
    animation: spin 0.75s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* ==================== LOADED VIDEO PREVIEW CONTENT ==================== */
  .preview-split {
    display: none;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }

  .preview-split.show {
    display: grid;
  }

  /* Video Player / Thumbnail Box */
  .media-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 14px;
    overflow: hidden;
    background: #0B1325;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.14);
  }

  .media-stage img,
  .media-stage video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .media-stage video {
    object-fit: contain;
    background: #000;
  }

  .media-play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.38) 100%);
    cursor: pointer;
    border: none;
    width: 100%;
    transition: background 0.18s ease;
  }

  .media-play-overlay:hover {
    background: linear-gradient(180deg, rgba(0,0,0,0.12) 0%, rgba(0,0,0,0.48) 100%);
  }

  .play-circle {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.68);
    border: 2px solid rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(6px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    transition: transform 0.16s ease;
  }

  .media-play-overlay:hover .play-circle {
    transform: scale(1.07);
  }

  .play-circle svg {
    width: 20px;
    height: 20px;
    fill: #FFFFFF;
    margin-left: 3px;
  }

  .duration-pill {
    position: absolute;
    right: 10px;
    bottom: 10px;
    background: rgba(11, 20, 40, 0.82);
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 6px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    pointer-events: none;
  }

  /* Preview Details Right Side */
  .preview-details {
    min-width: 0;
    width: 100%;
  }

  .video-title {
    font-size: 17px;
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.38;
    margin-bottom: 10px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    word-break: break-word;
  }

  .creator-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .creator-avatar {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    object-fit: cover;
    background: #E2E8F0;
    flex-shrink: 0;
    display: none;
  }

  .creator-icon-badge {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(99, 59, 255, 0.1);
    color: var(--purple-600);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  html[data-theme="dark"] .creator-icon-badge {
    background: rgba(139, 92, 246, 0.2);
    color: #C4B5FD;
  }

  .creator-name {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text-sub);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .verified-badge {
    width: 15px;
    height: 15px;
    color: #3B82F6;
    display: none;
    align-items: center;
    flex-shrink: 0;
  }

  .stats-row {
    display: none;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-sub);
    margin-bottom: 14px;
    font-variant-numeric: tabular-nums;
  }

  .stat-item {
    display: none;
    align-items: center;
    gap: 5px;
  }

  .stat-item svg {
    width: 15px;
    height: 15px;
    color: var(--text-muted);
  }

  /* Format Mode Tabs (Video | Audio | Thumbnail) */
  .media-tabs {
    display: flex;
    gap: 6px;
    background: var(--card-sub);
    border: 1px solid var(--border-soft);
    padding: 4px;
    border-radius: 11px;
    margin-bottom: 12px;
  }

  .media-tab {
    flex: 1;
    height: 34px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: var(--text-sub);
    font-size: 13px;
    font-weight: 700;
    font-family: inherit;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .media-tab:hover {
    color: var(--text-main);
  }

  .media-tab.active {
    background: #E0E7FF;
    color: #4F46E5;
  }

  html[data-theme="dark"] .media-tab.active {
    background: rgba(99, 59, 255, 0.28);
    color: #C4B5FD;
  }

  /* Quality Selection Table - Properly Aligned */
  .quality-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }

  .quality-row {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr) auto auto 106px;
    align-items: center;
    gap: 10px;
    padding: 8px 10px 8px 12px;
    border-radius: 11px;
    border: 1px solid var(--border-soft);
    background: var(--card-bg);
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    width: 100%;
    box-sizing: border-box;
  }

  .quality-row:hover {
    border-color: #CBD5E1;
    background: var(--card-sub);
  }

  .quality-row.selected {
    border-color: #C7D2FE;
    background: #F5F7FF;
  }

  html[data-theme="dark"] .quality-row.selected {
    border-color: #4C1D95;
    background: rgba(99, 59, 255, 0.12);
  }

  .q-radio {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid #CBD5E1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .quality-row.selected .q-radio {
    border-color: var(--purple-600);
    background: var(--purple-600);
  }

  .quality-row.selected .q-radio::after {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #FFFFFF;
  }

  .q-name {
    font-weight: 700;
    color: var(--text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  .q-fmt {
    color: var(--text-sub);
    font-weight: 600;
    font-size: 12px;
    white-space: nowrap;
    padding: 2px 7px;
    border-radius: 6px;
    background: var(--card-sub);
    border: 1px solid var(--border-soft);
  }

  .q-size {
    color: var(--text-sub);
    font-weight: 500;
    font-size: 12.5px;
    white-space: nowrap;
    text-align: right;
    min-width: 48px;
  }

  .q-size:empty {
    min-width: 0;
    display: none;
  }

  .btn-row-dl {
    width: 106px;
    height: 32px;
    padding: 0 10px;
    border-radius: 8px;
    background: var(--btn-grad);
    color: #FFFFFF;
    border: none;
    font-size: 12.5px;
    font-weight: 700;
    font-family: inherit;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    justify-self: end;
    box-shadow: 0 3px 10px rgba(99, 59, 255, 0.25);
    transition: filter 0.15s ease, transform 0.12s ease;
  }

  .btn-row-dl:hover:not(:disabled) {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }

  .btn-row-dl:disabled {
    opacity: 0.65;
    cursor: wait;
  }

  /* Photo Gallery / Album Grid inside Preview Card */
  .gallery-box {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border-soft);
    display: none;
  }

  .gallery-box.show {
    display: block;
  }

  .gallery-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-sub);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    gap: 10px;
  }

  .gallery-item {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: #0F172A;
    border: 1px solid var(--border-soft);
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gallery-item-actions {
    position: absolute;
    inset: auto 6px 6px 6px;
    display: flex;
    gap: 4px;
    justify-content: flex-end;
  }

  .gallery-dl-chip {
    background: rgba(11, 20, 40, 0.82);
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
  }

  .gallery-dl-chip:hover {
    background: var(--purple-600);
  }

  /* ==================== RIGHT COLUMN: WHY CHOOSE & HOW TO DOWNLOAD ==================== */
  .right-column-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 22px;
  }

  .section-sub {
    font-size: 13.5px;
    color: var(--text-sub);
    margin-top: -10px;
    margin-bottom: 16px;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .feature-box {
    border: 1px solid var(--border-soft);
    background: var(--card-sub);
    border-radius: 14px;
    padding: 14px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .feat-icon {
    width: 40px;
    height: 40px;
    border-radius: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .feat-icon.orange {
    background: #FFF7ED;
    color: #F97316;
  }

  .feat-icon.green {
    background: #ECFDF5;
    color: #10B981;
  }

  .feat-icon.purple {
    background: #EEF2FF;
    color: #633BFF;
  }

  html[data-theme="dark"] .feat-icon.orange { background: rgba(249, 115, 22, 0.15); }
  html[data-theme="dark"] .feat-icon.green { background: rgba(16, 185, 129, 0.15); }
  html[data-theme="dark"] .feat-icon.purple { background: rgba(99, 59, 255, 0.2); }

  .feat-text h4 {
    font-size: 14px;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 4px;
  }

  .feat-text p {
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--text-sub);
  }

  /* How to Download Section */
  .guide-link {
    font-size: 13px;
    font-weight: 700;
    color: var(--purple-600);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    background: none;
    border: none;
    font-family: inherit;
  }

  .guide-link:hover {
    text-decoration: underline;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    padding-top: 4px;
  }

  .step-card {
    position: relative;
    text-align: center;
    padding: 6px 8px;
  }

  .step-card:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -8px;
    top: 22px;
    color: #CBD5E1;
    font-weight: 700;
    font-size: 16px;
  }

  .step-top {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-bottom: 8px;
  }

  .step-num {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--purple-600);
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .step-ico {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: #EEF2FF;
    color: var(--purple-600);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  html[data-theme="dark"] .step-ico {
    background: rgba(99, 59, 255, 0.2);
    color: #A78BFA;
  }

  .step-card h5 {
    font-size: 13.5px;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 3px;
  }

  .step-card p {
    font-size: 11.5px;
    line-height: 1.4;
    color: var(--text-sub);
  }

  /* ==================== FOOTER ==================== */
  .site-footer {
    background: #081020;
    color: #94A3B8;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    padding: 22px 28px;
    margin-top: auto;
  }

  .footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer-brand-text strong {
    display: block;
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 800;
  }

  .footer-brand-text span {
    font-size: 12px;
    color: #64748B;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 12.5px;
  }

  .footer-links a {
    color: #CBD5E1;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: #FFFFFF;
  }

  .footer-links .pipe {
    color: #334155;
  }

  .footer-right {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .social-link {
    color: #CBD5E1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .social-link:hover {
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.08);
  }

  .scroll-top-btn {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #1E293B;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #E2E8F0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .scroll-top-btn:hover {
    background: var(--purple-600);
    color: #FFFFFF;
    transform: translateY(-2px);
  }

  /* ==================== MODALS (SETTINGS & FAQ/GUIDE) ==================== */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(7, 13, 29, 0.65);
    backdrop-filter: blur(6px);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .modal-backdrop.show {
    display: flex;
  }

  .modal-dialog {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 20px;
    width: 100%;
    max-width: 600px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
    overflow: hidden;
  }

  .modal-header {
    padding: 18px 22px;
    border-bottom: 1px solid var(--border-soft);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .modal-header h3 {
    font-size: 17px;
    font-weight: 800;
    color: var(--text-main);
  }

  .modal-close {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 18px;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 8px;
  }

  .modal-close:hover {
    color: var(--text-main);
    background: var(--card-sub);
  }

  .modal-body {
    padding: 20px 22px;
    max-height: 70vh;
    overflow-y: auto;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-sub);
  }

  .modal-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
  }

  .modal-tab {
    flex: 1;
    padding: 9px 12px;
    border-radius: 10px;
    border: 1px solid var(--border-color);
    background: var(--card-sub);
    color: var(--text-sub);
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
    font-family: inherit;
  }

  .modal-tab.active {
    background: var(--purple-600);
    border-color: var(--purple-600);
    color: #FFFFFF;
  }

  .cfg-field {
    width: 100%;
    border: 1px solid var(--border-color);
    background: var(--card-sub);
    color: var(--text-main);
    border-radius: 11px;
    padding: 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12.5px;
    margin-top: 8px;
    margin-bottom: 12px;
    outline: none;
  }

  .cfg-field:focus {
    border-color: var(--purple-600);
  }

  /* Toast Notification */
  .toast-box {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 300;
    background: #0B1428;
    color: #FFFFFF;
    border: 1px solid rgba(139, 92, 246, 0.45);
    padding: 12px 18px;
    border-radius: 12px;
    font-size: 13.5px;
    font-weight: 600;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
    display: none;
    align-items: center;
    gap: 10px;
  }

  .toast-box.show {
    display: inline-flex;
  }

  /* Responsive Adjustments */
  @media (max-width: 1120px) {
    .hero-callout-left,
    .hero-deco-right {
      display: none;
    }
    .dashboard-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .main-nav {
      display: none;
    }
    .preview-split.show {
      grid-template-columns: 1fr;
    }
    .features-grid,
    .steps-grid {
      grid-template-columns: 1fr;
    }
    .step-card::after {
      display: none;
    }
    .quality-row {
      grid-template-columns: 18px minmax(0, 1fr) auto 100px;
    }
    .q-fmt {
      display: none;
    }
    .search-bar {
      flex-wrap: wrap;
      padding: 10px;
    }
    .btn-fetch {
      width: 100%;
      justify-content: center;
    }
  }
</style>
</head>
<body>

<!-- ==================== HEADER ==================== -->
<header class="site-header">
  <div class="header-inner">
    <a href="#" class="brand-link" id="brandHomeLink">
      <span class="brand-logo" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M8 5.14v13.72a1 1 0 0 0 1.55.83l11-6.86a1 1 0 0 0 0-1.66l-11-6.86A1 1 0 0 0 8 5.14z"/></svg>
      </span>
      <span>DownDouyin</span>
    </a>

    <nav class="main-nav" aria-label="Primary Navigation">
      <a href="#top" class="nav-item active" data-nav="home" id="navHome">Home</a>
      <a href="#platformsRow" class="nav-item" data-nav="platforms" id="navPlatforms">Supported Platforms</a>
      <a href="#howToSection" class="nav-item" data-nav="howto" id="navHowTo">How to Use</a>
      <div class="nav-dropdown-wrap" id="toolsDropdownWrap">
        <button type="button" class="nav-item" id="navToolsBtn">
          <span id="navToolsLabel">Tools</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="nav-dropdown">
          <button type="button" class="dropdown-item" data-tool="video">🎬 High-Speed Video Downloader</button>
          <button type="button" class="dropdown-item" data-tool="audio">🎵 Original Audio / MP3 Extractor</button>
          <button type="button" class="dropdown-item" data-tool="thumb">🖼️ HD Thumbnail &amp; Gallery Grabber</button>
          <button type="button" class="dropdown-item" data-tool="settings">⚙️ Bilibili Cookie &amp; TikTok Proxy</button>
        </div>
      </div>
      <button type="button" class="nav-item" id="navFaqBtn">FAQ</button>
    </nav>

    <div class="header-right">
      <button type="button" class="theme-pill" id="themeToggle" aria-label="Toggle Light/Dark Theme" title="Switch Theme">
        <span class="sun-icon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="5"/><path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72 1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </span>
        <span class="knob"></span>
      </button>

      <div class="lang-wrap" id="langWrap">
        <button type="button" class="lang-btn" id="langBtn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          <span id="currentLangText">English</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="lang-menu">
          <button type="button" class="lang-opt active" data-lang="en">English</button>
          <button type="button" class="lang-opt" data-lang="zh">简体中文</button>
        </div>
      </div>

      <button type="button" class="btn-upgrade" id="btnHeaderSettings" title="Configure Bilibili HD Cookies &amp; TikTok Proxy">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5zm14 3c0 .6-.4 1-1 1H6c-.6 0-1-.4-1-1v-1h14v1z"/></svg>
        <span id="upgradeBtnText">Upgrade</span>
      </button>
    </div>
  </div>
</header>

<!-- ==================== HERO SECTION ==================== -->
<section class="hero-section" id="top">
  <!-- Decorative Cosmic Waves -->
  <svg class="hero-bg-waves" viewBox="0 0 1440 360" fill="none" preserveAspectRatio="none">
    <path d="M-80 40 C 140 120, 260 280, 480 290 C 700 300, 980 120, 1520 40" stroke="url(#gradWave1)" stroke-width="2.5" stroke-opacity="0.55"/>
    <path d="M-60 190 C 160 90, 320 260, 580 280 C 860 300, 1150 180, 1500 90" stroke="url(#gradWave2)" stroke-width="1.8" stroke-opacity="0.4"/>
    <defs>
      <linearGradient id="gradWave1" x1="0" y1="0" x2="1440" y2="360" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#38BDF8"/>
        <stop offset="50%" stop-color="#8B5CF6" stop-opacity="0.2"/>
        <stop offset="100%" stop-color="#60A5FA"/>
      </linearGradient>
      <linearGradient id="gradWave2" x1="1440" y1="0" x2="0" y2="360" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#A855F7"/>
        <stop offset="50%" stop-color="#3B82F6" stop-opacity="0.15"/>
        <stop offset="100%" stop-color="#8B5CF6"/>
      </linearGradient>
    </defs>
  </svg>

  <div class="hero-container">
    <!-- Left Decorative Callout -->
    <div class="hero-callout-left" aria-hidden="true">
      <div class="callout-lines">
        All<br>
        <span class="hl">Your Favorite</span><br>
        <span class="hl">Platforms</span><br>
        in One Place
      </div>
      <svg width="58" height="58" viewBox="0 0 64 64" fill="none" style="margin-left:78px;margin-top:-12px">
        <path d="M8 8 C 34 14, 46 32, 42 56" stroke="#CBD5E1" stroke-width="2" stroke-linecap="round"/>
        <path d="M36 49 L 42 57 L 49 50" stroke="#CBD5E1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>

    <!-- Main Heading -->
    <h1 class="hero-title">
      <span id="heroTitleTop">Download Videos from</span>
      <span class="grad-text" id="heroTitleGrad">Douyin, Bilibili, TikTok and Xiaohongshu</span>
    </h1>

    <div class="hero-subtitle">
      <span id="subFast">Fast</span>
      <span class="dot-sep">•</span>
      <span id="subSimple">Simple</span>
      <span class="dot-sep">•</span>
      <span id="subHq">High Quality</span>
    </div>

    <!-- Search Input Bar -->
    <div class="search-bar-outer">
      <div class="search-bar">
        <span class="search-link-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        </span>
        <input
          type="text"
          id="urlInput"
          class="search-input"
          placeholder="Paste video URL here... (Douyin, Bilibili, TikTok, Xiaohongshu etc.)"
          autocomplete="off"
          spellcheck="false"
        >
        <button type="button" class="search-clear-btn" id="btnClearInput" title="Clear input" aria-label="Clear URL input">✕</button>
        <button type="button" class="btn-fetch" id="btnFetch">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span id="btnFetchLabel">Fetch Video</span>
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <!-- 4 Supported Platforms Row -->
    <div class="hero-platforms" id="platformsRow">
      <button type="button" class="plat-btn active" data-platform="douyin" title="Douyin Downloader">
        <span class="plat-icon-box douyin">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48z" fill="#25F4EE" transform="translate(-0.8, -0.6)"/>
            <path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48z" fill="#FE2C55" transform="translate(0.8, 0.6)"/>
            <path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48z" fill="#FFFFFF"/>
          </svg>
        </span>
        <span>Douyin</span>
      </button>

      <button type="button" class="plat-btn" data-platform="bilibili" title="Bilibili Downloader">
        <span class="plat-icon-box bilibili">
          <span style="color:#fff;font-weight:800;font-size:12px;letter-spacing:-0.5px">bilibili</span>
        </span>
        <span>Bilibili</span>
      </button>

      <button type="button" class="plat-btn" data-platform="tiktok" title="TikTok Downloader">
        <span class="plat-icon-box tiktok">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48z" fill="#25F4EE" transform="translate(-0.8, -0.6)"/>
            <path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48z" fill="#FE2C55" transform="translate(0.8, 0.6)"/>
            <path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48z" fill="#FFFFFF"/>
          </svg>
        </span>
        <span>TikTok</span>
      </button>

      <button type="button" class="plat-btn" data-platform="xiaohongshu" title="Xiaohongshu (RedNote) Downloader">
        <span class="plat-icon-box xhs">
          <span style="color:#fff;font-weight:800;font-size:11.5px;letter-spacing:-0.5px">小红书</span>
        </span>
        <span>Xiaohongshu</span>
      </button>
    </div>

    <!-- Right Decorative Callout & 3D Floating Platform Tiles -->
    <div class="hero-deco-right" aria-hidden="true">
      <div class="hero-callout-right">
        Paste<br>a link<br>Download<br>in seconds
        <svg width="46" height="42" viewBox="0 0 50 45" fill="none" style="display:block;margin-top:4px;margin-left:10px">
          <path d="M36 4 C 34 22, 22 32, 6 36" stroke="#CBD5E1" stroke-width="2" stroke-linecap="round"/>
          <path d="M13 30 L 5 36 L 14 41" stroke="#CBD5E1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="floating-tiles">
        <div class="float-tile tile-bili">bili</div>
        <div class="float-tile tile-tt-top">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
            <path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48z" fill="#25F4EE" transform="translate(-1, -0.8)"/>
            <path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48z" fill="#FE2C55" transform="translate(1, 0.8)"/>
            <path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48z" fill="#FFFFFF"/>
          </svg>
        </div>
        <div class="float-tile tile-dy-bot">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none">
            <path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48z" fill="#25F4EE" transform="translate(-0.9, -0.7)"/>
            <path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48z" fill="#FE2C55" transform="translate(0.9, 0.7)"/>
            <path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48z" fill="#FFFFFF"/>
          </svg>
        </div>
        <div class="float-tile tile-xhs">小红书</div>
      </div>
    </div>
  </div>

  <div class="hero-wave-bottom">
    <svg viewBox="0 0 1440 48" preserveAspectRatio="none">
      <path class="wave-fill" d="M0,12 C320,46 1120,46 1440,12 L1440,48 L0,48 Z"></path>
    </svg>
  </div>
</section>

<!-- ==================== MAIN CONTENT ==================== -->
<main class="main-workspace">

  <!-- Error Alert Banner -->
  <div class="error-banner" id="errorBanner" role="alert">
    <span id="errorText"></span>
    <button type="button" class="modal-close" id="btnCloseError" aria-label="Dismiss error">✕</button>
  </div>

  <!-- 2-Column Primary Section -->
  <div class="dashboard-grid">

    <!-- LEFT CARD: VIDEO PREVIEW -->
    <section class="panel-card preview-panel-card" aria-labelledby="videoPreviewTitle">
      <div class="section-head">
        <div class="section-title-group">
          <span class="section-bar"></span>
          <h2 class="section-title" id="videoPreviewTitle">Video Preview</h2>
        </div>
        <div id="biliPartSelectBox" style="display:none"></div>
      </div>

      <!-- Empty State (Shown on initial load before any video is fetched) -->
      <div class="preview-empty-state" id="previewEmptyState">
        <div class="empty-state-icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="4"/>
            <polygon points="10 8 16 12 10 16" fill="currentColor" stroke="none"/>
          </svg>
        </div>
        <p class="empty-state-msg" id="previewEmptyMsg">Paste a video link and select Fetch Video to preview details.</p>
      </div>

      <!-- Loading State (Shown while fetching from backend) -->
      <div class="preview-loading-state" id="previewLoadingState">
        <div class="loading-spinner" aria-hidden="true"></div>
        <p class="empty-state-msg" id="previewLoadingMsg">Fetching video details...</p>
      </div>

      <!-- Real Fetched Video Preview Content (Hidden until backend returns valid data) -->
      <div class="preview-split" id="previewSplit">
        <!-- Left Media Column -->
        <div>
          <div class="media-stage" id="mediaStage"></div>
        </div>

        <!-- Right Metadata + Tabs + Quality Rows -->
        <div class="preview-details">
          <h3 class="video-title" id="previewTitle" style="display:none"></h3>

          <div class="creator-row" id="creatorRow" style="display:none">
            <img
              id="creatorAvatar"
              class="creator-avatar"
              alt="Creator Avatar"
              referrerPolicy="no-referrer"
            >
            <span class="creator-icon-badge" id="creatorIconBadge" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </span>
            <span class="creator-name" id="creatorName"></span>
            <span class="verified-badge" id="verifiedBadge" title="Verified Creator">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            </span>
          </div>

          <div class="stats-row" id="statsRow">
            <span class="stat-item" id="statViewsItem">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              <span id="statViews"></span>
            </span>
            <span class="stat-item" id="statDateItem">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <span id="statDate"></span>
            </span>
            <span class="stat-item" id="statDurationItem">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span id="statDuration"></span>
            </span>
          </div>

          <!-- Video / Audio / Thumbnail Tabs -->
          <div class="media-tabs" id="mediaTabs" role="tablist">
            <button type="button" class="media-tab active" data-tab="video" id="tabBtnVideo">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="2" y="4" width="20" height="16" rx="4"/><polygon points="10 8 16 12 10 16" fill="#fff"/></svg>
              <span id="tabLabelVideo">Video</span>
            </button>
            <button type="button" class="media-tab" data-tab="audio" id="tabBtnAudio">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
              <span id="tabLabelAudio">Audio</span>
            </button>
            <button type="button" class="media-tab" data-tab="thumbnail" id="tabBtnThumb">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              <span id="tabLabelThumb">Thumbnail</span>
            </button>
          </div>

          <!-- Quality / Format Rows Container -->
          <div class="quality-list" id="qualityList"></div>
        </div>
      </div>

      <!-- Photo Album / Live Photo Gallery Container (shown when post has multiple images) -->
      <div class="gallery-box" id="galleryBox">
        <div class="gallery-head">
          <span id="gallerySummaryText">Photo Album</span>
          <button type="button" class="btn-row-dl" style="width:auto;padding:0 14px" id="btnDownloadZip">⬇ Download All (ZIP)</button>
        </div>
        <div class="gallery-grid" id="galleryGrid"></div>
      </div>
    </section>

    <!-- RIGHT CARD: WHY CHOOSE DOWNDOUYIN + HOW TO DOWNLOAD -->
    <aside class="panel-card right-column-card">
      <div>
        <div class="section-head">
          <div class="section-title-group">
            <span class="section-bar"></span>
            <h2 class="section-title" id="whyChooseTitle">Why Choose DownDouyin?</h2>
          </div>
        </div>
        <p class="section-sub" id="whyChooseSub">A simple and powerful way to download your favorite videos.</p>

        <div class="features-grid">
          <div class="feature-box">
            <div class="feat-icon orange">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            </div>
            <div class="feat-text">
              <h4 id="feat1Title">Fast &amp; Reliable</h4>
              <p id="feat1Desc">Get your videos in seconds with stable servers.</p>
            </div>
          </div>

          <div class="feature-box">
            <div class="feat-icon green">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L4 5v6.09c0 5.05 3.41 9.76 8 10.91 4.59-1.15 8-5.86 8-10.91V5l-8-3zm-1.06 13.54L7.4 12l1.41-1.41 2.12 2.12 4.24-4.24 1.41 1.41-5.64 5.66z"/></svg>
            </div>
            <div class="feat-text">
              <h4 id="feat2Title">No Watermark</h4>
              <p id="feat2Desc">Clean and high-quality downloads.</p>
            </div>
          </div>

          <div class="feature-box">
            <div class="feat-icon purple">
