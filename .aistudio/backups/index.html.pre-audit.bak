<!-- ==================== FAQ & DETAILED GUIDE MODAL ==================== -->
<div class="modal-backdrop" id="faqModal" role="dialog" aria-modal="true" aria-labelledby="faqModalTitle">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 id="faqModalTitle">How to Use &amp; Frequently Asked Questions</h3>
      <button type="button" class="modal-close" id="btnCloseFaq">✕</button>
    </div>
    <div class="modal-body">
      <h4 style="color:var(--text-main);font-weight:800;margin-bottom:6px">1. Which platforms are supported?</h4>
      <p style="margin-bottom:14px">DownDouyin supports <strong>Douyin</strong>, <strong>Bilibili</strong>, <strong>TikTok</strong>, and <strong>Xiaohongshu (RedNote)</strong>. You can paste either a direct link or the full share text copied from the mobile app.</p>

      <h4 style="color:var(--text-main);font-weight:800;margin-bottom:6px">2. How do I download watermark-free videos in Original Quality?</h4>
      <p style="margin-bottom:14px">Paste your video link in the search box and click <strong>Fetch Video</strong>. DownDouyin queries the stream endpoints and lists all available qualities returned by the platform (such as Original Quality, 1080p Full HD, 720p HD, 540p SD). Click <strong>Download</strong> next to your preferred quality.</p>

      <h4 style="color:var(--text-main);font-weight:800;margin-bottom:6px">3. Why does Xiaohongshu require a fresh share link?</h4>
      <p style="margin-bottom:14px">Xiaohongshu links include a temporary <code>xsec_token</code> parameter for security. Copy the share link directly from the Xiaohongshu app or web page without removing URL parameters.</p>

      <h4 style="color:var(--text-main);font-weight:800;margin-bottom:6px">4. Can I extract audio or high-res cover thumbnails?</h4>
      <p>Yes! After fetching a video, switch between the <strong>Video</strong>, <strong>Audio</strong>, and <strong>Thumbnail</strong> tabs inside the Video Preview card to download the original soundtrack or HD cover image when provided by the source platform.</p>
    </div>
  </div>
</div>

<!-- Toast Feedback -->
<div class="toast-box" id="toastBox" role="status" aria-live="polite"></div>

<script>
(function() {
  const $ = id => document.getElementById(id);

  /* ==================== API BASE RESOLUTION ==================== */
  const SERVICE_PORT = '__SERVICE_PORT__';
  const _PORT = /^\d+$/.test(SERVICE_PORT) ? SERVICE_PORT : '3000';
  const _IS_LOCAL = location.protocol === 'file:' ||
    ['localhost', '127.0.0.1', '0.0.0.0', '[::1]', '::1'].includes(location.hostname);
  const API_BASE = (_IS_LOCAL && location.port && location.port !== _PORT)
    ? 'http://127.0.0.1:' + _PORT
    : '';

  /* ==================== PLATFORM CONFIGURATION ==================== */
  const PLATFORMS = {
    douyin: {
      name: 'Douyin',
      placeholder: 'Paste video URL here... (Douyin, Bilibili, TikTok, Xiaohongshu etc.)'
    },
    bilibili: {
      name: 'Bilibili',
      placeholder: 'Paste Bilibili video URL or BV ID here...'
    },
    tiktok: {
      name: 'TikTok',
      placeholder: 'Paste TikTok video link here...'
    },
    xiaohongshu: {
      name: 'Xiaohongshu',
      placeholder: 'Paste Xiaohongshu (RedNote) share text or link here...'
    }
  };

  /* ==================== APPLICATION STATE ==================== */
  let currentPlatform = 'douyin';
  let currentLang = localStorage.getItem('dd_lang') || 'en';
  let currentMediaTab = 'video';
  let selectedQualityIdx = 0;
  let activeMediaData = null; // Null until a real fetch succeeds
  let isFetching = false;
  let sizeProbeCache = {};

  /* ==================== I18N TRANSLATIONS ==================== */
  const I18N = {
    en: {
      navHome: 'Home',
      navPlatforms: 'Supported Platforms',
      navHowTo: 'How to Use',
      navToolsLabel: 'Tools',
      upgradeBtnText: 'Upgrade',
      heroTitleTop: 'Download Videos from',
      heroTitleGrad: 'Douyin, Bilibili, TikTok and Xiaohongshu',
      subFast: 'Fast',
      subSimple: 'Simple',
      subHq: 'High Quality',
      btnFetchLabel: 'Fetch Video',
      videoPreviewTitle: 'Video Preview',
      previewEmptyMsg: 'Paste a video link and select Fetch Video to preview details.',
      previewLoadingMsg: 'Fetching video details...',
      tabLabelVideo: 'Video',
      tabLabelAudio: 'Audio',
      tabLabelThumb: 'Thumbnail',
      whyChooseTitle: 'Why Choose DownDouyin?',
      whyChooseSub: 'A simple and powerful way to download your favorite videos.',
      feat1Title: 'Fast & Reliable',
      feat1Desc: 'Get your videos in seconds with stable servers.',
      feat2Title: 'No Watermark',
      feat2Desc: 'Clean and high-quality downloads.',
      feat3Title: 'Supports Many Platforms',
      feat3Desc: 'Douyin, Bilibili, TikTok and Xiaohongshu.',
      feat4Title: '100% Free to Use',
      feat4Desc: 'No registration required. Start downloading now.',
      howToTitle: 'How to Download?',
      guideLinkText: 'View Detailed Guide',
      step1Title: 'Paste Link',
      step1Desc: 'Copy and paste the video URL above.',
      step2Title: 'Choose Format',
      step2Desc: 'Select your preferred quality and format.',
      step3Title: 'Download',
      step3Desc: 'Click download and enjoy your video.',
      footerTagline: 'Your All-in-One Video Downloader',
      dlBtn: 'Download'
    },
    zh: {
      navHome: '首页',
      navPlatforms: '支持平台',
      navHowTo: '使用教程',
      navToolsLabel: '工具箱',
      upgradeBtnText: '高清配置',
      heroTitleTop: '一键无水印解析下载',
      heroTitleGrad: '抖音、哔哩哔哩、TikTok 与 小红书视频',
      subFast: '极速',
      subSimple: '简洁',
      subHq: '原画超清',
      btnFetchLabel: '解析视频',
      videoPreviewTitle: '视频预览',
      previewEmptyMsg: '粘贴视频链接并点击“解析视频”以预览详情。',
      previewLoadingMsg: '正在解析视频信息...',
      tabLabelVideo: '视频',
      tabLabelAudio: '音频',
      tabLabelThumb: '封面图',
      whyChooseTitle: '为什么选择 DownDouyin？',
      whyChooseSub: '简单高效的无水印视频直链解析下载工具。',
      feat1Title: '极速稳定',
      feat1Desc: '秒级响应解析，高速直链流式传输。',
      feat2Title: '纯净无水印',
      feat2Desc: '直接提取原画无水印高码率片源。',
      feat3Title: '四大主流平台',
      feat3Desc: '全面支持抖音、B站、TikTok 与小红书。',
      feat4Title: '100% 免费使用',
      feat4Desc: '无需注册登录，粘贴链接即可下载。',
      howToTitle: '如何下载视频？',
      guideLinkText: '查看详细指南',
      step1Title: '粘贴链接',
      step1Desc: '在上方输入框粘贴分享链接。',
      step2Title: '选择格式画质',
      step2Desc: '按需切换视频分辨率、音频或封面。',
      step3Title: '立即下载',
      step3Desc: '点击下载按钮保存到本地设备。',
      footerTagline: '全能无水印视频解析下载站',
      dlBtn: '下载'
    }
  };

  /* ==================== HELPERS ==================== */
  function showToast(msg) {
    const box = $('toastBox');
    if (!box) return;
    box.textContent = msg;
    box.classList.add('show');
    clearTimeout(showToast._timer);
    showToast._timer = setTimeout(() => box.classList.remove('show'), 3200);
  }

  function showError(msg) {
    const banner = $('errorBanner');
    const txt = $('errorText');
    if (!msg) {
      banner.classList.remove('show');
      return;
    }
    txt.textContent = msg;
    banner.classList.add('show');
  }

  function buildProxyUrl(rawUrl, platform, altUrls) {
    if (!rawUrl) return '';
    let u = API_BASE + '/api/proxy?url=' + encodeURIComponent(rawUrl) +
      '&platform=' + encodeURIComponent(platform || currentPlatform);
    if (Array.isArray(altUrls) && altUrls.length > 1) {
      u += '&alt=' + encodeURIComponent(JSON.stringify(altUrls.slice(0, 4)));
    }
    return u;
  }

  function buildDownloadUrl(rawUrl, prefix, platform, mediaType, forceExt, altUrls) {
    if (!rawUrl) return '';
    let u = API_BASE + '/api/download?url=' + encodeURIComponent(rawUrl) +
      '&prefix=' + encodeURIComponent(prefix || 'DownDouyin') +
      '&platform=' + encodeURIComponent(platform || currentPlatform) +
      '&type=' + encodeURIComponent(mediaType || 'video');
    if (forceExt) u += '&ext=' + encodeURIComponent(forceExt);
    if (Array.isArray(altUrls) && altUrls.length > 1) {
      u += '&alt=' + encodeURIComponent(JSON.stringify(altUrls.slice(0, 4)));
    }
    return u;
  }

  function sanitizeFilename(raw) {
    return String(raw || 'DownDouyin_video')
      .replace(/[\\/:*?"<>|#\r\n]+/g, '_')
      .trim()
      .slice(0, 65) || 'DownDouyin_video';
  }

  function formatBytes(bytes) {
    const n = Number(bytes);
    if (!Number.isFinite(n) || n <= 0) return '';
    if (n >= 1024 * 1024) {
      return (n / (1024 * 1024)).toFixed(1) + ' MB';
    }
    if (n >= 1024) {
      return Math.round(n / 1024) + ' KB';
    }
    return n + ' B';
  }

  /* ==================== GOOGLE ANALYTICS 4 SAFE EVENT HELPERS ==================== */
  const ALLOWED_PLATFORMS = ['douyin', 'tiktok', 'bilibili', 'xiaohongshu'];

  function sanitizeAnalyticsPlatform(plat) {
    const p = String(plat || currentPlatform || '').trim().toLowerCase();
    return ALLOWED_PLATFORMS.includes(p) ? p : 'unknown';
  }

  function categorizeClientError(errOrMsg) {
    const msg = String((errOrMsg && errOrMsg.message) ? errOrMsg.message : (errOrMsg || '')).toLowerCase();
    if (!msg) return 'unknown_error';
    if (msg.includes('纯数字作品') || msg.includes('ambiguous')) return 'ambiguous_numeric_id';
    if (msg.includes('没识别出链接所属平台') || msg.includes('unsupported')) return 'unsupported_platform';
    if (msg.includes('xsec_token') || msg.includes('安全限制') || msg.includes('过期')) return 'expired_or_restricted_link';
    if (msg.includes('cookie') || msg.includes('sessdata') || msg.includes('login')) return 'auth_or_cookie_required';
    if (msg.includes('404') || msg.includes('not found') || msg.includes('不存在') || msg.includes('已删除')) return 'media_not_found';
    if (msg.includes('stalled') || msg.includes('timeout')) return 'stream_stall_or_timeout';
    if (msg.includes('chunk download failed')) return 'chunk_transfer_error';
    if (msg.includes('http 5')) return 'server_http_5xx';
    if (msg.includes('http 4')) return 'server_http_4xx';
    if (msg.includes('zip')) return 'zip_archive_error';
    if (msg.includes('empty video data')) return 'empty_parse_data';
    if (msg.includes('network') || msg.includes('failed to fetch') || msg.includes('load failed')) return 'network_error';
    return 'request_error';
  }

  function trackAnalyticsEvent(eventName, rawParams) {
    if (typeof window.gtag !== 'function') return;
    try {
      const safeParams = {};
      if (rawParams && typeof rawParams === 'object') {
        if (rawParams.platform) {
          safeParams.platform = sanitizeAnalyticsPlatform(rawParams.platform);
        }
        if (rawParams.status === 'success' || rawParams.status === 'failed' || rawParams.status === 'started') {
          safeParams.status = rawParams.status;
        }
        if (rawParams.error_category) {
          safeParams.error_category = String(rawParams.error_category).replace(/[^a-z0-9_]/gi, '_').slice(0, 40);
        }
        if (rawParams.download_method) {
          safeParams.download_method = String(rawParams.download_method).replace(/[^a-z0-9_]/gi, '_').slice(0, 40);
        }
      }
      window.gtag('event', eventName, safeParams);
    } catch {
      // Never allow analytics errors to interrupt user functionality
    }
  }

  const sizeBytesCache = {};
  const inflightSizeProbes = {};

  function readStreamChunkWithTimeout(reader, timeoutMs) {
    let timer = null;
    return Promise.race([
      reader.read(),
      new Promise((_, reject) => {
        timer = setTimeout(() => reject(new Error('Download stream stalled')), timeoutMs);
      })
    ]).finally(() => {
      if (timer) clearTimeout(timer);
    });
  }

  function updateDownloadButtonProgress(btnEl, receivedBytes, totalBytes) {
    if (!btnEl) return;
    if (totalBytes > 0) {
      const pct = Math.min(99, Math.max(1, Math.floor((receivedBytes / totalBytes) * 100)));
      btnEl.innerHTML = '<span>⬇ ' + pct + '%</span>';
    } else if (receivedBytes > 0) {
      btnEl.innerHTML = '<span>⬇ ' + formatBytes(receivedBytes) + '</span>';
    }
  }

  /* ==================== SAFE NON-NAVIGATING DOWNLOAD HANDLER ==================== */
  /* On production VPS (downdouyin.com), streams continuously in a single HTTP request via /api/download
     with automatic Range resume and mirror representation verification if interrupted.
     Compacts incoming Uint8Array chunks into Blob segments every 4MB so JS heap memory stays flat. */
  async function downloadFileSafely(targetUrl, filename, btnEl, rawMediaUrl, platform, downloadMethod, knownSizeBytes, altUrls) {
    if (!targetUrl && !rawMediaUrl) return;
    if (btnEl && btnEl.disabled) return;

    // Pause any active preview video playback so preview streaming does not compete for bandwidth
    const activePreviewVideo = document.querySelector('#mediaStage video');
    if (activePreviewVideo && typeof activePreviewVideo.pause === 'function') {
      try { activePreviewVideo.pause(); } catch {}
    }

    const cleanPlat = sanitizeAnalyticsPlatform(platform || currentPlatform);
    const cleanMethod = String(downloadMethod || 'video_stream').replace(/[^a-z0-9_]/gi, '_');
    const dlReqId = 'dl_' + Date.now().toString(36) + '_' + Math.random().toString(36).substring(2, 7);

    // 1. Track user click on download button (distinct from completed download)
    trackAnalyticsEvent('download_button_click', {
      platform: cleanPlat,
      download_method: cleanMethod
    });

    const origHtml = btnEl ? btnEl.innerHTML : '';
    if (btnEl) {
      btnEl.disabled = true;
      btnEl.innerHTML = '<span>⏳ 0%</span>';
    }

    // 2. Track actual file transfer request started
    trackAnalyticsEvent('download_request_started', {
      platform: cleanPlat,
      download_method: cleanMethod,
      status: 'started'
    });

    const blobSegments = [];
    const ramBatch = [];
    let ramBatchBytes = 0;
    const COMPACT_BATCH_BYTES = 4 * 1024 * 1024; // Compact into Blob storage every 4 MB to avoid JS heap buildup

    function flushRamBatch(mimeType) {
      if (ramBatch.length === 0) return;
      blobSegments.push(new Blob(ramBatch, { type: mimeType || 'video/mp4' }));
      ramBatch.length = 0;
      ramBatchBytes = 0;
    }

    function appendChunk(u8, mimeType) {
      ramBatch.push(u8);
      ramBatchBytes += u8.byteLength;
      if (ramBatchBytes >= COMPACT_BATCH_BYTES) {
        flushRamBatch(mimeType);
      }
    }

    function resetBuffers() {
      blobSegments.length = 0;
      ramBatch.length = 0;
      ramBatchBytes = 0;
    }

    try {
      const isCloudRunHost = window.location.hostname.endsWith('.run.app');
      const CHUNK_SIZE = 16 * 1024 * 1024; // 16 MB chunk cap only used on Cloud Run (*.run.app)
      const baseEndpoint = targetUrl || buildProxyUrl(rawMediaUrl, cleanPlat, altUrls);
      const hasAltParam = baseEndpoint.includes('&alt=');
      let downloadEndpoint = baseEndpoint +
        (baseEndpoint.includes('?') ? '&' : '?') +
        'dl=1&method=' + encodeURIComponent(cleanMethod) +
        '&req_id=' + encodeURIComponent(dlReqId);
      if (!hasAltParam && Array.isArray(altUrls) && altUrls.length > 1) {
        downloadEndpoint += '&alt=' + encodeURIComponent(JSON.stringify(altUrls.slice(0, 5)));
      }

      let totalSize = Number(knownSizeBytes) > 0
        ? Number(knownSizeBytes)
        : (rawMediaUrl && sizeBytesCache[rawMediaUrl] ? sizeBytesCache[rawMediaUrl] : 0);
      let supportsRange = false;
      let contentType = 'video/mp4';
      let received = 0;
      let fullRestartCount = 0;
      const MAX_FULL_RESTARTS = 1;

      while (true) {
        resetBuffers();
        received = 0;

        const firstHeaders = {};
        if (isCloudRunHost) {
          firstHeaders['Range'] = 'bytes=0-' + (CHUNK_SIZE - 1);
        }

        const firstResp = await fetch(downloadEndpoint, {
          method: 'GET',
          headers: firstHeaders
        });

        if (!firstResp.ok && firstResp.status !== 206) {
          throw new Error('Download server returned HTTP ' + firstResp.status);
        }

        contentType = firstResp.headers.get('Content-Type') || contentType;
        const contentRange = firstResp.headers.get('Content-Range') || '';
        const acceptRanges = (firstResp.headers.get('Accept-Ranges') || '').toLowerCase();
        if (acceptRanges.includes('bytes') || firstResp.status === 206) {
          supportsRange = true;
        }

        if (firstResp.status === 206 && contentRange) {
          const m = contentRange.match(/\/(\d+)$/);
          if (m) {
            totalSize = parseInt(m[1], 10);
            supportsRange = totalSize > 0;
          }
        } else {
          const cl = parseInt(firstResp.headers.get('Content-Length') || '0', 10);
          if (cl > 0) totalSize = cl;
        }

        if (firstResp.body && typeof firstResp.body.getReader === 'function') {
          const reader = firstResp.body.getReader();
          try {
            while (true) {
              const { done, value } = await readStreamChunkWithTimeout(reader, 22000);
              if (done) break;
              if (value && value.byteLength > 0) {
                appendChunk(value, contentType);
                received += value.byteLength;
                updateDownloadButtonProgress(btnEl, received, totalSize);
              }
            }
          } catch (streamErr) {
            try { await reader.cancel(); } catch {}
            if (!supportsRange || totalSize <= 0 || received === 0) {
              if (fullRestartCount < MAX_FULL_RESTARTS) {
                fullRestartCount++;
                continue;
              }
              throw streamErr;
            }
          }
        } else {
          const buf = new Uint8Array(await firstResp.arrayBuffer());
          if (buf.byteLength > 0) {
            appendChunk(buf, contentType);
            received += buf.byteLength;
            updateDownloadButtonProgress(btnEl, received, totalSize);
          }
        }

        // Continue fetching remaining bytes if chunked (on Cloud Run) or if a continuous stream dropped mid-transfer
        let resumeRetries = 0;
        const MAX_RESUME_RETRIES = 3;
        let needFullRestart = false;

        while (supportsRange && totalSize > 0 && received < totalSize) {
          const start = received;
          const end = isCloudRunHost
            ? Math.min(start + CHUNK_SIZE - 1, totalSize - 1)
            : (totalSize - 1);

          try {
            const resumeUrl = downloadEndpoint + '&expected_size=' + encodeURIComponent(String(totalSize));
            const partResp = await fetch(resumeUrl, {
              method: 'GET',
              headers: { 'Range': 'bytes=' + start + '-' + end }
            });

            if (partResp.status === 409 || partResp.status === 416) {
              // Alternate mirror has a different representation size; restart cleanly from byte 0 instead of corrupting
              needFullRestart = true;
              break;
            }

            if (partResp.status !== 206) {
              throw new Error('Range resume returned HTTP ' + partResp.status);
            }

            const partCr = partResp.headers.get('Content-Range') || '';
            const crMatch = partCr.match(/bytes\s+(\d+)-(\d+)\/(\d+)/i);
            if (!crMatch || parseInt(crMatch[1], 10) !== start || parseInt(crMatch[3], 10) !== totalSize) {
              needFullRestart = true;
              try { await partResp.body?.cancel(); } catch {}
              break;
            }

            if (partResp.body && typeof partResp.body.getReader === 'function') {
              const reader = partResp.body.getReader();
              let partBytes = 0;
              try {
                while (true) {
                  const { done, value } = await readStreamChunkWithTimeout(reader, 22000);
                  if (done) break;
                  if (value && value.byteLength > 0) {
                    appendChunk(value, contentType);
                    received += value.byteLength;
                    partBytes += value.byteLength;
                    updateDownloadButtonProgress(btnEl, received, totalSize);
                  }
                }
              } catch (partStreamErr) {
                try { await reader.cancel(); } catch {}
                if (partBytes === 0) throw partStreamErr;
              }
              if (partBytes === 0) {
                throw new Error('Chunk download returned 0 bytes');
              }
            } else {
              const buf = new Uint8Array(await partResp.arrayBuffer());
              if (buf.byteLength === 0) break;
              appendChunk(buf, contentType);
              received += buf.byteLength;
              updateDownloadButtonProgress(btnEl, received, totalSize);
            }
          } catch (resumeErr) {
            resumeRetries++;
            if (resumeRetries > MAX_RESUME_RETRIES) {
              if (fullRestartCount < MAX_FULL_RESTARTS) {
                needFullRestart = true;
                break;
              }
              throw resumeErr;
            }
          }
        }

        if (needFullRestart && fullRestartCount < MAX_FULL_RESTARTS) {
          fullRestartCount++;
          continue;
        }
        break;
      }

      if (received === 0) {
        throw new Error('Download returned empty payload');
      }
      if (totalSize > 0 && received < totalSize) {
        throw new Error('Incomplete media transfer (' + formatBytes(received) + ' / ' + formatBytes(totalSize) + ')');
      }

      flushRamBatch(contentType);
      const blob = blobSegments.length === 1 ? blobSegments[0] : new Blob(blobSegments, { type: contentType });
      resetBuffers();

      const blobUrl = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = blobUrl;
      a.download = filename || 'DownDouyin_video.mp4';
      a.style.display = 'none';
      document.body.appendChild(a);
      a.click();
      setTimeout(() => {
        URL.revokeObjectURL(blobUrl);
        a.remove();
      }, 6000);

      // 3. Track completed file transfer ONLY after full verified payload is assembled and saved
      trackAnalyticsEvent('download_request_success', {
        platform: cleanPlat,
        download_method: cleanMethod,
        status: 'success'
      });

      if (btnEl) {
        btnEl.innerHTML = '<span>✓ Saved</span>';
        setTimeout(() => {
          btnEl.disabled = false;
          btnEl.innerHTML = origHtml;
        }, 1600);
      }
      showToast('Download complete: ' + (filename || 'video.mp4'));
    } catch (err) {
      resetBuffers();
      // 4. Track failed file transfer with non-sensitive error_category
      trackAnalyticsEvent('download_request_failed', {
        platform: cleanPlat,
        download_method: cleanMethod,
        status: 'failed',
        error_category: categorizeClientError(err)
      });
      showError('Download failed: ' + (err && err.message ? err.message : 'Network error'));
      if (btnEl) {
        btnEl.disabled = false;
        btnEl.innerHTML = origHtml;
      }
    }
  }

  /* ==================== AUTO-DETECT PLATFORM FROM URL ==================== */
  function detectPlatformFromText(text) {
    const s = String(text || '').toLowerCase();
    if (s.includes('bilibili.com') || s.includes('b23.tv') || /\bbv[0-9a-z]{10}\b/i.test(text)) {
      return 'bilibili';
    }
    if (s.includes('tiktok.com')) {
      return 'tiktok';
    }
    if (s.includes('xiaohongshu.com') || s.includes('xhslink.com')) {
      return 'xiaohongshu';
    }
    if (s.includes('douyin.com') || s.includes('iesdouyin.com')) {
      return 'douyin';
    }
    return null;
  }

  function setActivePlatform(plat) {
    if (!PLATFORMS[plat]) return;
    currentPlatform = plat;
    document.querySelectorAll('.plat-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.platform === plat);
    });
    const input = $('urlInput');
    if (input) {
      input.placeholder = PLATFORMS[plat].placeholder;
    }
  }

  /* ==================== QUALITY LABEL & REAL SIZE PROBING ==================== */
  function formatDurationSeconds(val) {
    if (typeof val === 'string' && val.includes(':')) return val.trim();
    const sec = Math.round(Number(val));
    if (!Number.isFinite(sec) || sec <= 0) return '';
    const mins = Math.floor(sec / 60);
    const rem = sec % 60;
    return String(mins).padStart(2, '0') + ':' + String(rem).padStart(2, '0');
  }

  function formatTimestampDate(ts) {
    const n = Number(ts);
    if (!Number.isFinite(n) || n <= 0) return '';
    const ms = n < 1e12 ? n * 1000 : n;
    const d = new Date(ms);
    if (isNaN(d.getTime())) return '';
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  }

  function formatCountNumber(n) {
    const num = Number(n);
    if (!Number.isFinite(num) || num <= 0) return '';
    if (num >= 1e6) return (num / 1e6).toFixed(1).replace(/\.0$/, '') + 'M';
    if (num >= 1e3) return (num / 1e3).toFixed(1).replace(/\.0$/, '') + 'K';
    return String(num);
  }

  function normalizeBackendResponse(rawJson) {
    const d = (rawJson && typeof rawJson.data === 'object' && rawJson.data !== null)
      ? rawJson.data
      : rawJson;
    if (!d || typeof d !== 'object') return null;

    const plat = rawJson.platform || d.platform || currentPlatform;
    const authorName = typeof d.author === 'string'
      ? d.author.trim()
      : (d.author && typeof d.author === 'object'
        ? String(d.author.nickname || d.author.name || d.author.uniqueId || '').trim()
        : '');

    const avatarUrl = d.author_avatar ||
      (d.author && Array.isArray(d.author.avatar) && d.author.avatar[0]) ||
      (d.author && typeof d.author.avatar === 'string' ? d.author.avatar : '') ||
      d.avatar || '';

    const coverUrl = d.cover || d.cover_url || (Array.isArray(d.images) && d.images[0]) || '';
    const musicUrl = (d.music && typeof d.music === 'object' ? d.music.url : '') || d.music_url || '';

    const rawVideoUrls = Array.isArray(d.video_urls) ? d.video_urls.filter(Boolean) : [];
    const rawQualities = (Array.isArray(d.qualities) ? d.qualities : []).map(q => {
      if (!q || typeof q !== 'object') return q;
      const qUrls = Array.isArray(q.urls) && q.urls.length > 0
        ? q.urls
        : (q.url && rawVideoUrls.includes(q.url) ? rawVideoUrls : (q.url ? [q.url] : []));
      return { ...q, urls: qUrls };
    });
    const primaryVideoUrl = d.video_url ||
      rawVideoUrls[0] ||
      (rawQualities[0] && rawQualities[0].url) || '';

    const rawLive = Array.isArray(d.live_videos)
      ? d.live_videos
      : (Array.isArray(d.live_photos) ? d.live_photos : []);
    const livePhotos = rawLive.map((lp, i) => ({
      index: lp.index || (i + 1),
      video_url: lp.video_url || lp.url || (Array.isArray(lp.urls) && lp.urls[0]) || '',
      urls: Array.isArray(lp.urls) ? lp.urls : []
    })).filter(lp => Boolean(lp.video_url));

    const playCount = d.stats && Number(d.stats.play) > 0 ? formatCountNumber(d.stats.play) + ' views' : '';
    const diggCount = (!playCount && d.stats && Number(d.stats.digg) > 0) ? formatCountNumber(d.stats.digg) + ' likes' : '';

    return {
      platform: plat,
      aweme_id: d.aweme_id || d.id || d.bvid || '',
      type: d.type || (Array.isArray(d.images) && d.images.length > 0 && !primaryVideoUrl ? 'images' : 'video'),
      desc: String(d.title || d.desc || '').trim(),
      author: authorName,
      avatar: avatarUrl,
      verified: Boolean(d.verified),
      cover_url: coverUrl,
      video_url: primaryVideoUrl,
      video_urls: rawVideoUrls,
      music_url: musicUrl,
      duration: formatDurationSeconds(d.duration),
      date: d.create_time ? formatTimestampDate(d.create_time) : (d.date ? String(d.date) : ''),
      views: d.views ? String(d.views) : (playCount || diggCount),
      qualities: rawQualities,
      images: Array.isArray(d.images) ? d.images : [],
      live_photos: livePhotos,
      pages: Array.isArray(d.pages) ? d.pages : []
    };
  }

  function parseQualityDisplay(q, idx) {
    const rawId = String(q.id || q.name || '').toLowerCase();
    const rawLabel = String(q.label || q.shortLabel || 'HD');
    const lowerLabel = rawLabel.toLowerCase();
    const resNum = Number(q.resolution) || 0;

    let name = rawLabel;

    if (idx === 0 || rawId === 'origin' || rawId === 'original' || q.tag === 'Original' || rawLabel.includes('原画') || lowerLabel.includes('origin')) {
      name = currentLang === 'zh' ? '原画质量 (Original)' : 'Original Quality';
    } else if (rawId === '120' || resNum >= 2160 || lowerLabel.includes('4k') || lowerLabel.includes('2160')) {
      name = currentLang === 'zh' ? '4K 超清' : '4K Ultra HD';
    } else if (resNum >= 1440 || lowerLabel.includes('2k') || lowerLabel.includes('1440')) {
      name = '2K QHD';
    } else if (resNum >= 1080 || rawId.includes('1080') || rawLabel.includes('1080')) {
      if (rawLabel.includes('60')) {
        name = '1080p 60fps';
      } else {
        name = '1080p Full HD';
      }
    } else if (resNum >= 720 || rawId.includes('720') || rawLabel.includes('720')) {
      name = '720p HD';
    } else if (resNum >= 540 || rawId.includes('540') || rawLabel.includes('540') || rawLabel.includes('576')) {
      name = '540p SD';
    } else if (resNum >= 480 || rawId.includes('480') || rawLabel.includes('480')) {
      name = '480p SD';
    } else if (resNum >= 360 || rawId.includes('360') || rawLabel.includes('360')) {
      name = '360p SD';
    } else if (rawId === 'hd' || rawId === 'default') {
      name = 'HD Quality';
    } else if (rawId === 'sd') {
      name = 'SD Quality';
    }

    let formattedSize = '';
    if (typeof q.size === 'number' && q.size > 0) {
      formattedSize = formatBytes(q.size);
    } else if (typeof q.size === 'string' && q.size.trim() && q.size.trim() !== '0') {
      formattedSize = /^\d+$/.test(q.size.trim()) ? formatBytes(Number(q.size.trim())) : q.size.trim();
    }

    return {
      name,
      format: q.format || 'MP4',
      size: formattedSize
    };
  }

  async function probeQualitySize(rawUrl, platform, cellEl, altUrls) {
    if (!rawUrl || !cellEl) return;
    if (sizeProbeCache[rawUrl]) {
      cellEl.textContent = sizeProbeCache[rawUrl];
      return;
    }
    if (inflightSizeProbes[rawUrl]) {
      try {
        const formatted = await inflightSizeProbes[rawUrl];
        if (formatted) cellEl.textContent = formatted;
      } catch {}
      return;
    }
    const probeTask = (async () => {
      try {
        const proxyUrl = buildProxyUrl(rawUrl, platform, altUrls);
        const resp = await fetch(proxyUrl, { method: 'HEAD' });
        const len = resp.headers.get('Content-Length');
        const numBytes = Number(len);
        const formatted = formatBytes(len);
        if (formatted) {
          sizeProbeCache[rawUrl] = formatted;
          if (Number.isFinite(numBytes) && numBytes > 0) {
            sizeBytesCache[rawUrl] = numBytes;
          }
          return formatted;
        }
      } catch {
        // Leave size cell empty if upstream CDN does not expose Content-Length
      } finally {
        delete inflightSizeProbes[rawUrl];
      }
      return '';
    })();

    inflightSizeProbes[rawUrl] = probeTask;
    const formatted = await probeTask;
    if (formatted) {
      cellEl.textContent = formatted;
    }
  }

  /* ==================== VIDEO PREVIEW STATE MANAGEMENT ==================== */
  function stopActiveMediaPlayback() {
    const stage = $('mediaStage');
    if (!stage) return;
    const vid = stage.querySelector('video');
    if (vid) {
      try {
        vid.pause();
        vid.removeAttribute('src');
        vid.load();
      } catch {}
    }
    const aud = stage.querySelector('audio');
    if (aud) {
      try {
        aud.pause();
        aud.removeAttribute('src');
      } catch {}
    }
  }

  function showPreviewEmptyState() {
    stopActiveMediaPlayback();
    activeMediaData = null;
    $('previewEmptyState').style.display = 'flex';
    $('previewLoadingState').style.display = 'none';
    $('previewSplit').classList.remove('show');
    $('galleryBox').classList.remove('show');
    $('biliPartSelectBox').style.display = 'none';
  }

  function showPreviewLoadingState() {
    stopActiveMediaPlayback();
    $('previewEmptyState').style.display = 'none';
    $('previewLoadingState').style.display = 'flex';
    $('previewSplit').classList.remove('show');
    $('galleryBox').classList.remove('show');
  }

  function renderPreviewCard(data) {
    if (!data) {
      showPreviewEmptyState();
      return;
    }

    activeMediaData = data;
    $('previewEmptyState').style.display = 'none';
    $('previewLoadingState').style.display = 'none';
    $('previewSplit').classList.add('show');

    const plat = data.platform || currentPlatform;

    // 1. Title (only shown if backend returned title/desc)
    const titleEl = $('previewTitle');
    const rawTitle = String(data.desc || '').trim();
    if (rawTitle) {
      titleEl.textContent = rawTitle;
      titleEl.style.display = '-webkit-box';
    } else {
      titleEl.textContent = '';
      titleEl.style.display = 'none';
    }

    // 2. Creator (only shown if backend returned author)
    const creatorRow = $('creatorRow');
    const creatorNameEl = $('creatorName');
    const avatarEl = $('creatorAvatar');
    const iconBadgeEl = $('creatorIconBadge');
    const verifiedEl = $('verifiedBadge');
    const rawAuthor = String(data.author || '').trim();

    if (rawAuthor) {
      creatorRow.style.display = 'flex';
      creatorNameEl.textContent = rawAuthor;
      if (data.avatar) {
        avatarEl.src = buildProxyUrl(data.avatar, plat);
        avatarEl.style.display = 'block';
        iconBadgeEl.style.display = 'none';
        avatarEl.onerror = () => {
          avatarEl.style.display = 'none';
          iconBadgeEl.style.display = 'inline-flex';
        };
      } else {
        avatarEl.removeAttribute('src');
        avatarEl.style.display = 'none';
        iconBadgeEl.style.display = 'inline-flex';
      }
      verifiedEl.style.display = data.verified ? 'inline-flex' : 'none';
    } else {
      creatorRow.style.display = 'none';
    }

    // 3. Stats Row (only display fields that actually exist in backend response)
    const statsRow = $('statsRow');
    const viewsItem = $('statViewsItem');
    const dateItem = $('statDateItem');
    const durationItem = $('statDurationItem');

    let hasAnyStat = false;
    if (data.views) {
      $('statViews').textContent = String(data.views);
      viewsItem.style.display = 'inline-flex';
      hasAnyStat = true;
    } else {
      viewsItem.style.display = 'none';
    }

    if (data.date) {
      $('statDate').textContent = String(data.date);
      dateItem.style.display = 'inline-flex';
      hasAnyStat = true;
    } else {
      dateItem.style.display = 'none';
    }

    if (data.duration) {
      $('statDuration').textContent = String(data.duration);
      durationItem.style.display = 'inline-flex';
      hasAnyStat = true;
    } else {
      durationItem.style.display = 'none';
    }

    statsRow.style.display = hasAnyStat ? 'flex' : 'none';

    // 4. Configure Available Format Tabs based on actual backend response
    const hasVideo = Boolean(
      data.video_url ||
      (Array.isArray(data.qualities) && data.qualities.length > 0) ||
      (Array.isArray(data.live_photos) && data.live_photos.length > 0)
    );
    const hasAudio = Boolean(data.music_url);
    const hasThumb = Boolean(
      data.cover_url ||
      (Array.isArray(data.images) && data.images.length > 0)
    );

    $('tabBtnVideo').style.display = hasVideo ? 'inline-flex' : 'none';
    $('tabBtnAudio').style.display = hasAudio ? 'inline-flex' : 'none';
    $('tabBtnThumb').style.display = hasThumb ? 'inline-flex' : 'none';

    if (currentMediaTab === 'video' && !hasVideo) {
      currentMediaTab = hasThumb ? 'thumbnail' : (hasAudio ? 'audio' : 'video');
    } else if (currentMediaTab === 'audio' && !hasAudio) {
      currentMediaTab = hasVideo ? 'video' : 'thumbnail';
    } else if (currentMediaTab === 'thumbnail' && !hasThumb) {
      currentMediaTab = hasVideo ? 'video' : 'audio';
    }

    document.querySelectorAll('.media-tab').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.tab === currentMediaTab);
    });

    // 5. Render Media Stage (Thumbnail + Playable Video)
    renderMediaStage(data);

    // 6. Render Quality / Format Rows
    renderQualityRows(data);

    // 7. Render Gallery Box if multi-image post (Douyin / Xiaohongshu / TikTok photo notes)
    renderGalleryIfPresent(data);
  }

  function renderMediaStage(data) {
    const stage = $('mediaStage');
    if (!stage) return;
    stage.innerHTML = '';

    const plat = data.platform || currentPlatform;
    const rawCover = data.cover_url || (Array.isArray(data.images) && data.images[0]) || '';
    const coverSrc = rawCover ? buildProxyUrl(rawCover, plat) : '';

    const qualities = Array.isArray(data.qualities) && data.qualities.length
      ? data.qualities
      : (data.video_url ? [{ id: 'default', label: 'Original Quality', url: data.video_url, urls: data.video_urls || [data.video_url] }] : []);
    const activeQ = qualities[selectedQualityIdx] || qualities[0];
    const rawVideoUrl = activeQ ? activeQ.url : data.video_url;
    const activeAltUrls = activeQ && Array.isArray(activeQ.urls) && activeQ.urls.length > 0
      ? activeQ.urls
      : (Array.isArray(data.video_urls) ? data.video_urls : []);

    if (coverSrc) {
      const img = document.createElement('img');
      img.src = coverSrc;
      img.alt = data.desc || 'Video preview thumbnail';
      img.referrerPolicy = 'no-referrer';
      stage.appendChild(img);
    }

    if (rawVideoUrl && data.type !== 'images') {
      const playOverlay = document.createElement('button');
      playOverlay.type = 'button';
      playOverlay.className = 'media-play-overlay';
      playOverlay.setAttribute('aria-label', 'Play Video Preview');
      playOverlay.innerHTML =
        '<span class="play-circle"><svg viewBox="0 0 24 24"><polygon points="8,5 19,12 8,19"/></svg></span>';

      playOverlay.addEventListener('click', () => {
        stage.innerHTML = '';
        const video = document.createElement('video');
        video.controls = true;
        video.autoplay = true;
        video.playsInline = true;
        video.preload = 'metadata';
        video.style.width = '100%';
        video.style.height = '100%';
        if (coverSrc) video.poster = coverSrc;
        video.src = buildProxyUrl(rawVideoUrl, plat, activeAltUrls);
        stage.appendChild(video);
      });

      stage.appendChild(playOverlay);
    }

    if (data.duration) {
      const dur = document.createElement('span');
      dur.className = 'duration-pill';
      dur.textContent = data.duration;
      stage.appendChild(dur);
    }
  }

  function renderQualityRows(data) {
    const listEl = $('qualityList');
    if (!listEl) return;
    listEl.innerHTML = '';

    const plat = data.platform || currentPlatform;
    const dlLabel = (I18N[currentLang] && I18N[currentLang].dlBtn) || 'Download';
    const baseName = sanitizeFilename((data.author ? data.author + '_' : '') + (data.aweme_id || 'video'));

    if (currentMediaTab === 'audio') {
      if (!data.music_url) return;
      const row = document.createElement('div');
      row.className = 'quality-row selected';
      row.innerHTML = `
        <span class="q-radio"></span>
        <span class="q-name">${currentLang === 'zh' ? '原声音乐 (Original Audio)' : 'Original Audio'}</span>
        <span class="q-fmt">MP3</span>
        <span class="q-size" id="audioSizeCell"></span>
        <button type="button" class="btn-row-dl">⬇ ${dlLabel}</button>
      `;
      const sizeCell = row.querySelector('#audioSizeCell');
      probeQualitySize(data.music_url, plat, sizeCell);

      const dlBtn = row.querySelector('.btn-row-dl');
      dlBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const dlUrl = buildDownloadUrl(data.music_url, baseName + '_audio', plat, 'music', '.mp3');
        downloadFileSafely(dlUrl, baseName + '_audio.mp3', dlBtn, data.music_url, plat, 'audio_mp3');
      });
      listEl.appendChild(row);
      return;
    }

    if (currentMediaTab === 'thumbnail') {
      const coverUrl = data.cover_url || (Array.isArray(data.images) && data.images[0]) || '';
      if (!coverUrl) return;
      const row = document.createElement('div');
      row.className = 'quality-row selected';
      row.innerHTML = `
        <span class="q-radio"></span>
        <span class="q-name">${currentLang === 'zh' ? '高清封面 (HD Cover)' : 'Original Thumbnail'}</span>
        <span class="q-fmt">JPG</span>
        <span class="q-size" id="thumbSizeCell"></span>
        <button type="button" class="btn-row-dl">⬇ ${dlLabel}</button>
      `;
      const sizeCell = row.querySelector('#thumbSizeCell');
      probeQualitySize(coverUrl, plat, sizeCell);

      const dlBtn = row.querySelector('.btn-row-dl');
      dlBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const dlUrl = buildDownloadUrl(coverUrl, baseName + '_cover', plat, 'image', '.jpg');
        downloadFileSafely(dlUrl, baseName + '_cover.jpg', dlBtn, coverUrl, plat, 'thumbnail_jpg');
      });
      listEl.appendChild(row);
      return;
    }

    // Video Tab: Build rows strictly from backend qualities
    const rawQualities = Array.isArray(data.qualities) && data.qualities.length
      ? data.qualities
      : (data.video_url ? [{ id: 'origin', label: 'Original Quality', url: data.video_url, urls: data.video_urls || [data.video_url] }] : []);

    if (selectedQualityIdx >= rawQualities.length) {
      selectedQualityIdx = 0;
    }

    rawQualities.forEach((q, idx) => {
      const info = parseQualityDisplay(q, idx);
      const row = document.createElement('div');
      row.className = 'quality-row' + (idx === selectedQualityIdx ? ' selected' : '');
      row.innerHTML = `
        <span class="q-radio"></span>
        <span class="q-name" title="${info.name}">${info.name}</span>
        <span class="q-fmt">${info.format}</span>
        <span class="q-size">${info.size}</span>
        <button type="button" class="btn-row-dl">⬇ ${dlLabel}</button>
      `;

      const sizeCell = row.querySelector('.q-size');
      const altUrls = Array.isArray(q.urls) && q.urls.length > 0
        ? q.urls
        : (Array.isArray(data.video_urls) ? data.video_urls : []);
      if (!info.size && q.url) {
        probeQualitySize(q.url, plat, sizeCell, altUrls);
      }

      row.addEventListener('click', () => {
        selectedQualityIdx = idx;
        document.querySelectorAll('#qualityList .quality-row').forEach((r, i) => {
          r.classList.toggle('selected', i === idx);
        });
        renderMediaStage(data);
      });

      const dlBtn = row.querySelector('.btn-row-dl');
      dlBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        selectedQualityIdx = idx;
        document.querySelectorAll('#qualityList .quality-row').forEach((r, i) => {
          r.classList.toggle('selected', i === idx);
        });
        const targetRawUrl = q.url || data.video_url;
        const qTag = idx === 0 ? 'Original' : String(q.resolution || q.id || q.name || 'HD').replace(/[^a-zA-Z0-9]/g, '');
        const fname = `${baseName}_${qTag}.mp4`;
        const knownBytes = (typeof q.size === 'number' && q.size > 0) ? q.size : (sizeBytesCache[targetRawUrl] || 0);
        const dlUrl = buildDownloadUrl(targetRawUrl, `${baseName}_${qTag}`, plat, 'video', '.mp4', altUrls);
        downloadFileSafely(dlUrl, fname, dlBtn, targetRawUrl, plat, idx === 0 ? 'video_original_mp4' : 'video_mp4', knownBytes, altUrls);
      });

      listEl.appendChild(row);
    });
  }

  function renderGalleryIfPresent(data) {
    const box = $('galleryBox');
    const grid = $('galleryGrid');
    const summary = $('gallerySummaryText');
    if (!box || !grid) return;

    const images = Array.isArray(data.images) ? data.images : [];
    const livePhotos = Array.isArray(data.live_photos) ? data.live_photos : [];

    if (images.length === 0 && livePhotos.length === 0) {
      box.classList.remove('show');
      grid.innerHTML = '';
      return;
    }

    box.classList.add('show');
    grid.innerHTML = '';
    const plat = data.platform || currentPlatform;
    const baseName = sanitizeFilename((data.author ? data.author + '_' : '') + (data.aweme_id || 'album'));

    summary.textContent = livePhotos.length > 0
      ? `Live Photo Album (${images.length} Photos + ${livePhotos.length} Live Videos)`
      : `Photo Album (${images.length} HD Images)`;

    images.forEach((imgUrl, idx) => {
      const card = document.createElement('div');
      card.className = 'gallery-item';
      const proxyImg = buildProxyUrl(imgUrl, plat);
      const matchingLive = livePhotos.find(lp => Number(lp.index) === idx + 1);

      card.innerHTML = `
        <img src="${proxyImg}" alt="Album item ${idx + 1}" loading="lazy" referrerPolicy="no-referrer">
        <div class="gallery-item-actions">
          <button type="button" class="gallery-dl-chip" data-kind="img">⬇ JPG</button>
          ${matchingLive && matchingLive.video_url ? '<button type="button" class="gallery-dl-chip" data-kind="live">⬇ Live MP4</button>' : ''}
        </div>
      `;

      const imgBtn = card.querySelector('[data-kind="img"]');
      imgBtn.addEventListener('click', () => {
        const dl = buildDownloadUrl(imgUrl, `${baseName}_${idx + 1}`, plat, 'image', '.jpg');
        downloadFileSafely(dl, `${baseName}_${idx + 1}.jpg`, imgBtn, imgUrl, plat, 'gallery_jpg');
      });

      const liveBtn = card.querySelector('[data-kind="live"]');
      if (liveBtn && matchingLive) {
        liveBtn.addEventListener('click', () => {
          const dl = buildDownloadUrl(matchingLive.video_url, `${baseName}_live_${idx + 1}`, plat, 'video', '.mp4');
          downloadFileSafely(dl, `${baseName}_live_${idx + 1}.mp4`, liveBtn, matchingLive.video_url, plat, 'gallery_live_mp4');
        });
      }

      grid.appendChild(card);
    });

    const zipBtn = $('btnDownloadZip');
    if (zipBtn) {
      zipBtn.onclick = async () => {
        if (zipBtn.disabled) return;
        const items = [];
        images.forEach((u, i) => items.push({ url: u, name: `${baseName}_img_${i + 1}.jpg` }));
        livePhotos.forEach((lp, i) => {
          if (lp && lp.video_url) {
            items.push({ url: lp.video_url, name: `${baseName}_live_${lp.index || (i + 1)}.mp4` });
          }
        });
        if (!items.length) return;

        const cleanPlat = sanitizeAnalyticsPlatform(plat);
        trackAnalyticsEvent('download_button_click', {
          platform: cleanPlat,
          download_method: 'album_zip'
        });

        const origText = zipBtn.innerHTML;
        zipBtn.disabled = true;
        zipBtn.innerHTML = '⏳ Packing ZIP...';

        trackAnalyticsEvent('download_request_started', {
          platform: cleanPlat,
          download_method: 'album_zip',
          status: 'started'
        });

        try {
          const resp = await fetch(API_BASE + '/api/zip', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items, prefix: baseName, platform: plat })
          });
          if (!resp.ok) throw new Error('ZIP Error HTTP ' + resp.status);
          const blob = await resp.blob();
          if (!blob || blob.size === 0) throw new Error('ZIP archive returned empty payload');
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `${baseName}_album.zip`;
          document.body.appendChild(a);
          a.click();
          setTimeout(() => {
            URL.revokeObjectURL(url);
            a.remove();
          }, 5000);

          trackAnalyticsEvent('download_request_success', {
            platform: cleanPlat,
            download_method: 'album_zip',
            status: 'success'
          });
          showToast('Album ZIP downloaded!');
        } catch (e) {
          trackAnalyticsEvent('download_request_failed', {
            platform: cleanPlat,
            download_method: 'album_zip',
            status: 'failed',
            error_category: categorizeClientError(e)
          });
          showError('ZIP download failed: ' + (e.message || 'Error'));
        } finally {
          zipBtn.disabled = false;
          zipBtn.innerHTML = origText;
        }
      };
    }
  }

  /* ==================== CORE FETCH VIDEO HANDLER (/api/parse) ==================== */
  async function handleFetchVideo() {
    if (isFetching) return;
    showError('');

    const inputEl = $('urlInput');
    const rawText = (inputEl ? inputEl.value : '').trim();
    if (!rawText) {
      showError(currentLang === 'zh'
        ? '请先在输入框中粘贴抖音、B站、TikTok 或小红书视频链接。'
        : 'Please paste a Douyin, Bilibili, TikTok, or Xiaohongshu video link first.');
      if (inputEl) inputEl.focus();
      return;
    }

    const detected = detectPlatformFromText(rawText);
    if (detected) {
      setActivePlatform(detected);
    }

    const submitPlatform = sanitizeAnalyticsPlatform(detected || currentPlatform);

    // Track link submission (distinct from a completed media file download)
    trackAnalyticsEvent('downloader_link_submit', {
      platform: submitPlatform,
      download_method: 'link_parse'
    });

    const btn = $('btnFetch');
    const origBtnHtml = btn.innerHTML;
    isFetching = true;
    btn.disabled = true;
    btn.innerHTML = '<span>⏳ Fetching...</span>';

    showPreviewLoadingState();

    try {
      const resp = await fetch(API_BASE + '/api/parse', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          text: rawText,
          platform: currentPlatform
        })
      });

      const rawJson = await resp.json();
      const isOk = resp.ok && !rawJson.error && (rawJson.success === true || rawJson.status === 'success' || Boolean(rawJson.data));
      if (!isOk) {
        throw new Error(rawJson.error || ('Failed to parse video (HTTP ' + resp.status + ')'));
      }

      const data = normalizeBackendResponse(rawJson);
      if (!data) {
        throw new Error('Empty video data returned from server.');
      }

      if (data.platform && PLATFORMS[data.platform]) {
        setActivePlatform(data.platform);
      }

      // Check Bilibili multi-part selector if returned by backend
      if (data.platform === 'bilibili' && Array.isArray(data.pages) && data.pages.length > 1) {
        renderBiliPagesSelect(data.pages, rawText);
      } else {
        $('biliPartSelectBox').style.display = 'none';
      }

      selectedQualityIdx = 0;
      currentMediaTab = data.type === 'images' ? 'thumbnail' : 'video';
      renderPreviewCard(data);
      showToast(currentLang === 'zh' ? '解析成功！请选择画质下载。' : 'Video fetched! Select a quality below to download.');
    } catch (err) {
      trackAnalyticsEvent('download_request_failed', {
        platform: submitPlatform,
        download_method: 'link_parse',
        status: 'failed',
        error_category: categorizeClientError(err)
      });
      showPreviewEmptyState();
      showError(err && err.message ? err.message : 'Unable to parse video link.');
    } finally {
      isFetching = false;
      btn.disabled = false;
      btn.innerHTML = origBtnHtml;
    }
  }

  function renderBiliPagesSelect(pages, rawText) {
    const box = $('biliPartSelectBox');
    if (!box) return;
    box.style.display = 'block';
    box.innerHTML = '';
    const sel = document.createElement('select');
    sel.style.cssText = 'padding:5px 10px;border-radius:8px;border:1px solid var(--border-color);background:var(--card-sub);color:var(--text-main);font-size:12px;font-weight:600;max-width:210px';
    pages.forEach(pg => {
      const opt = document.createElement('option');
      opt.value = pg.page;
      opt.textContent = `P${pg.page} - ${pg.part || ''}`;
      sel.appendChild(opt);
    });
    sel.addEventListener('change', () => {
      const baseClean = rawText.replace(/([?&])p=\d+/g, '');
      const sep = baseClean.includes('?') ? '&' : '?';
      $('urlInput').value = `${baseClean}${sep}p=${sel.value}`;
      handleFetchVideo();
    });
    box.appendChild(sel);
  }

  /* ==================== SETTINGS MODAL (BILIBILI & TIKTOK CONFIG) ==================== */
  async function refreshConfigStatus() {
    try {
      const bResp = await fetch(API_BASE + '/api/bili/config');
      const bData = await bResp.json();
      const bEl = $('biliCfgStatus');
      if (bEl) {
        bEl.textContent = bData.configured
          ? `✅ Configured (${bData.source || 'cookie'}, SESSDATA: ${bData.sessdata_preview || 'active'})`
          : 'ℹ️ Using default guest stream (up to 720P/1080P). Add SESSDATA for 4K Ultra HD.';
      }
    } catch {}

    try {
      const tResp = await fetch(API_BASE + '/api/tiktok/config');
      const tData = await tResp.json();
      const tEl = $('ttCfgStatus');
      if (tEl) {
        tEl.textContent = tData.configured
          ? `✅ Proxy active (${tData.proxy})`
          : 'ℹ️ Direct connection mode (no proxy configured).';
        if (tData.proxy && $('ttProxyInput')) {
          $('ttProxyInput').value = tData.proxy;
        }
      }
    } catch {}
  }

  /* ==================== LANGUAGE & THEME SWITCHING ==================== */
  function applyLanguage(lang) {
    currentLang = I18N[lang] ? lang : 'en';
    localStorage.setItem('dd_lang', currentLang);
    const dict = I18N[currentLang];

    Object.keys(dict).forEach(id => {
      const el = $(id);
      if (el) el.textContent = dict[id];
    });

    $('currentLangText').textContent = currentLang === 'zh' ? '简体中文' : 'English';
    document.querySelectorAll('.lang-opt').forEach(opt => {
      opt.classList.toggle('active', opt.dataset.lang === currentLang);
    });

    if (activeMediaData) {
      renderPreviewCard(activeMediaData);
    }
  }

  function applyTheme(theme) {
    const t = theme === 'dark' ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', t);
    localStorage.setItem('dd_theme', t);
  }

  /* ==================== INITIALIZATION & EVENT LISTENERS ==================== */
  function init() {
    // Theme initialization
    const savedTheme = localStorage.getItem('dd_theme') || 'light';
    applyTheme(savedTheme);

    $('themeToggle').addEventListener('click', () => {
      const cur = document.documentElement.getAttribute('data-theme');
      applyTheme(cur === 'dark' ? 'light' : 'dark');
    });

    // Language dropdown
    const langWrap = $('langWrap');
    $('langBtn').addEventListener('click', (e) => {
      e.stopPropagation();
      langWrap.classList.toggle('open');
    });
    document.querySelectorAll('.lang-opt').forEach(opt => {
      opt.addEventListener('click', () => {
        applyLanguage(opt.dataset.lang);
        langWrap.classList.remove('open');
      });
    });

    // Tools dropdown
    const toolsWrap = $('toolsDropdownWrap');
    $('navToolsBtn').addEventListener('click', (e) => {
      e.stopPropagation();
      toolsWrap.classList.toggle('open');
    });
    document.querySelectorAll('.dropdown-item').forEach(item => {
      item.addEventListener('click', () => {
        toolsWrap.classList.remove('open');
        const tool = item.dataset.tool;
        if (tool === 'video') {
          currentMediaTab = 'video';
          if (activeMediaData) renderPreviewCard(activeMediaData);
          $('urlInput').focus();
        } else if (tool === 'audio') {
          currentMediaTab = 'audio';
          if (activeMediaData) renderPreviewCard(activeMediaData);
          $('urlInput').focus();
        } else if (tool === 'thumb') {
          currentMediaTab = 'thumbnail';
          if (activeMediaData) renderPreviewCard(activeMediaData);
          $('urlInput').focus();
        } else if (tool === 'settings') {
          $('settingsModal').classList.add('show');
          refreshConfigStatus();
        }
      });
    });

    document.addEventListener('click', () => {
      langWrap.classList.remove('open');
      toolsWrap.classList.remove('open');
    });

    // Platform selector buttons
    document.querySelectorAll('.plat-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        setActivePlatform(btn.dataset.platform);
        $('urlInput').focus();
      });
    });

    // Search Input & Fetch Button
    const urlInput = $('urlInput');
    const clearBtn = $('btnClearInput');
    urlInput.addEventListener('input', () => {
      const val = urlInput.value.trim();
      clearBtn.classList.toggle('visible', val.length > 0);
      const detected = detectPlatformFromText(val);
      if (detected) setActivePlatform(detected);
    });
    urlInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        handleFetchVideo();
      }
    });
    clearBtn.addEventListener('click', () => {
      urlInput.value = '';
      clearBtn.classList.remove('visible');
      showError('');
      urlInput.focus();
    });
    $('btnFetch').addEventListener('click', handleFetchVideo);

    // Dismiss Error
    $('btnCloseError').addEventListener('click', () => showError(''));

    // Format Tabs (Video | Audio | Thumbnail)
    document.querySelectorAll('.media-tab').forEach(btn => {
      btn.addEventListener('click', () => {
        currentMediaTab = btn.dataset.tab;
        document.querySelectorAll('.media-tab').forEach(b => {
          b.classList.toggle('active', b === btn);
        });
        if (activeMediaData) {
          renderQualityRows(activeMediaData);
        }
      });
    });

    // Modals (Settings & FAQ/Guide)
    const openSettings = (e) => {
      if (e) e.preventDefault();
      $('settingsModal').classList.add('show');
      refreshConfigStatus();
    };
    const openFaq = (e) => {
      if (e) e.preventDefault();
      $('faqModal').classList.add('show');
    };

    $('btnHeaderSettings').addEventListener('click', openSettings);
    $('footerSettingsLink').addEventListener('click', openSettings);
    $('navFaqBtn').addEventListener('click', openFaq);
    $('btnDetailedGuide').addEventListener('click', openFaq);
    $('footerFaqLink').addEventListener('click', openFaq);
    $('footerGuideLink').addEventListener('click', openFaq);
    $('footerPrivacyLink').addEventListener('click', openFaq);
    $('footerTermsLink').addEventListener('click', openFaq);
    $('footerToolsLink').addEventListener('click', (e) => {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
      $('urlInput').focus();
    });

    $('btnCloseSettings').addEventListener('click', () => $('settingsModal').classList.remove('show'));
    $('btnCloseFaq').addEventListener('click', () => $('faqModal').classList.remove('show'));

    document.querySelectorAll('.modal-backdrop').forEach(backdrop => {
      backdrop.addEventListener('click', (e) => {
        if (e.target === backdrop) backdrop.classList.remove('show');
      });
    });

    // Settings Modal Tabs
    document.querySelectorAll('.modal-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.modal-tab').forEach(t => t.classList.toggle('active', t === tab));
        const pane = tab.dataset.pane;
        $('paneBili').style.display = pane === 'bili' ? 'block' : 'none';
        $('paneTiktok').style.display = pane === 'tiktok' ? 'block' : 'none';
      });
    });

    // Save / Clear Bilibili Cookie
    $('btnSaveBiliCookie').addEventListener('click', async () => {
      const val = $('biliCookieInput').value.trim();
      if (!val) return;
      try {
        const r = await fetch(API_BASE + '/api/bili/config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ cookie: val })
        });
        const d = await r.json();
        if (d.error) throw new Error(d.error);
        showToast('Bilibili SESSDATA saved!');
        refreshConfigStatus();
      } catch (e) {
        showError('Failed to save Bilibili cookie: ' + e.message);
      }
    });

    $('btnClearBiliCookie').addEventListener('click', async () => {
      try {
        await fetch(API_BASE + '/api/bili/config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ clear: true })
        });
        $('biliCookieInput').value = '';
        showToast('Bilibili cookie cleared.');
        refreshConfigStatus();
      } catch {}
    });

    // Save / Clear TikTok Proxy
    $('btnSaveTtProxy').addEventListener('click', async () => {
      const val = $('ttProxyInput').value.trim();
      try {
        const r = await fetch(API_BASE + '/api/tiktok/config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ proxy: val })
        });
        const d = await r.json();
        if (d.error) throw new Error(d.error);
        showToast('TikTok proxy updated!');
        refreshConfigStatus();
      } catch (e) {
        showError('Failed to save TikTok proxy: ' + e.message);
      }
    });

    $('btnClearTtProxy').addEventListener('click', async () => {
      try {
        await fetch(API_BASE + '/api/tiktok/config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ clear: true })
        });
        $('ttProxyInput').value = '';
        showToast('TikTok proxy cleared.');
        refreshConfigStatus();
      } catch {}
    });

    // Scroll to top button
    $('btnScrollTop').addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // Apply initial language & ensure empty state is active on load
    applyLanguage(currentLang);
    showPreviewEmptyState();
  }

  init();
})();
</script>
</body>
</html>
